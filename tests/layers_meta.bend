import Base
import ../src/layers/tar.bend as L
import ../src/layers/meta.bend as M

# Tests for src/layers/meta.bend: the .bend-meta files of Python tarfile
# vectors (laws/layers_tar.bend), in bend-vmm's format.

def report(name: String, got: String, want: String, ok: Bool) -> IO(Unit):
  match ok:
    case True{}:
      IO.print("PASS " ++ name)
    case False{}:
      IO.print("FAIL " ++ name ++ ": got " ++ got ++ ", want " ++ want)

def check(name: String, +got: String, +want: String) -> IO(Unit):
  report(name, got, want, String.eq(got, want))

def T.hexv.if(lower: Bool, x: U32) -> U32:
  match lower:
    case True{}:
      (x - 87 : U32)
    case False{}:
      (x - 48 : U32)

def T.hexv(c: Char) -> U32:
  match c:
    case Chr{+x}:
      T.hexv.if(U32.is_ge(x, 97), x)

def T.unhex(s: String) -> +List<U32>:
  match s:
    case SCon{a, SCon{b, t}}:
      (T.hexv(a) * 16 + T.hexv(b) : U32) <> T.unhex(t)
    case _:
      Nil{}

def T.pad(+bs: +List<U32>) -> +List<U32>:
  List.append(&2, U32, bs, List.replicate(U32, Nat.sub(512n, List.length(&2, U32, bs)), 0))

def T.tar(bs: List<&2, String>) -> +List<U32>:
  match bs:
    case Nil{}:
      Nil{}
    case Con{b, t}:
      List.append(&2, U32, T.pad(T.unhex(b)), T.tar(t))

def T.paths(ss: List<&2, M.Side>) -> List<&2, String>:
  match ss:
    case Nil{}:
      Nil{}
    case Con{M.Side{p, x}, t}:
      Con{p, T.paths(t)}

def T.texts(ss: List<&2, M.Side>) -> List<&2, String>:
  match ss:
    case Nil{}:
      Nil{}
    case Con{M.Side{p, x}, t}:
      Con{x, T.texts(t)}

def T.sides(r: Result<&2, &2, String, List<&2, L.Ent>>) -> List<&2, M.Side>:
  match r:
    case Fail{e}:
      Nil{}
    case Done{es}:
      M.Meta.sides(7, es)

def T.basic() -> +List<U32>:
  T.tar([
    "",
    "",
    "3132372e302e302e31206c6f63616c686f73740a",
    "",
    "",
    "",
    ""])

def T.whiteout() -> +List<U32>:
  T.tar([
    "",
    "",
    ""])

def T.pax() -> +List<U32>:
  T.tar([
    "",
    "3232206d74696d653d313730303030303030302e350a323920534348494c592e78617474722e757365722e746573743d68690a",
    "",
    "616263"])

def main() -> IO(Unit):
  do IO<Unit>:
    check("one file per directory", String.join(T.paths(T.sides(L.Tar.plan(T.basic()))), " "), ".bend-meta etc/.bend-meta dev/.bend-meta run/.bend-meta")
    check("hard links share an inode", String.join(T.texts(T.sides(L.Tar.plan(T.basic()))), "|"),
      "bend-meta 1\nname=etc host=etc type=d mode=755 uid=0 gid=0 mtime=1700000000\nname=dev host=dev type=d mode=755 uid=0 gid=0 mtime=0\nname=run host=run type=d mode=755 uid=0 gid=0 mtime=0\n|bend-meta 1\nname=hosts host=hosts type=f mode=644 uid=0 gid=0 mtime=1700000000 ino=30064771073 nlink=2\nname=mtab host=mtab type=l mode=777 uid=0 gid=0 mtime=1700000000\nname=hosts2 host=hosts2 type=f mode=644 uid=0 gid=0 mtime=1700000000 ino=30064771073 nlink=2\n|bend-meta 1\nname=null host=null type=c mode=666 uid=0 gid=0 rdev=1,3 mtime=1700000000\n|bend-meta 1\nname=initctl host=initctl type=p mode=600 uid=0 gid=0 mtime=1700000000\n")
    check("whiteout and opaque", String.join(T.texts(T.sides(L.Tar.plan(T.whiteout()))), "|"),
      "bend-meta 1\nname=a host=a type=d mode=755 uid=0 gid=0 mtime=1700000000 xattr.trusted.overlay.opaque=79\nname=gone host=gone type=c mode=0 uid=7 gid=8 rdev=0,0 mtime=1700000000\n")
    check("pax time and xattr", String.join(T.texts(T.sides(L.Tar.plan(T.pax()))), "|"),
      "bend-meta 1\nname=a.bin host=a.bin type=f mode=644 uid=1000 gid=1000 mtime=1700000000.500000000 xattr.user.test=6869\n")
    check("percent", M.Meta.pct("a b%"), "a%20b%25")
    check("octal", M.Meta.oct(1023), "1777")
