import Base
import bend-kube-runtime@0.2.0.0/src/json.bend as J
import ../src/guest/coredns.bend as C

# Scenario tests for src/guest/coredns.bend: the template branches the
# vcluster tests do not reach, the vk8s config record, toYaml, and the
# static file scripts/guest/coredns.yaml. Each line prints PASS or FAIL.

def T.line(+name: String, ok: Bool) -> String:
  match ok:
    case True{}:
      "PASS " ++ name
    case False{}:
      "FAIL " ++ name

def T.has(+name: String, +out: String, +part: String) -> String:
  T.line(name, String.contains(out, part))

def T.lacks(+name: String, +out: String, +part: String) -> String:
  T.line(name, Bool.not(String.contains(out, part)))

def T.eq(+name: String, +got: String, +want: String) -> String:
  T.line(name, String.eq(got, want))

def T.with(path: List<&2, String>, v: J.Json) -> J.Json:
  C.Coredns.put(path, C.Coredns.vcluster_defaults(), v)

def T.no_vars() -> C.Vars:
  C.Vars{"", "", "", ""}

def T.yaml(+name: String, +s: String, +want: String) -> String:
  T.eq(name, C.Coredns.to_yaml(J.JStr{s}), want)

# The manifest vk8s applies is scripts/guest/coredns.yaml, after the
# rewrites below: each turns a flow-style or reordered part of that
# hand-compacted file back into the text vcluster's template writes, or
# drops what the template cannot write (the comments). Every rewrite keeps
# the YAML's meaning, but for priorityClassName: "", which the API reads
# as unset. (A test, not a law: the whole file is too big for the BendTT
# kernel's fuel.)

# scripts/guest/coredns.yaml, byte for byte.
def T.fx.file() -> String:
  "# vcluster pkg/coredns/template.go, rendered with the default values\n"
  ++ "# (controlPlane.coredns, image coredns/coredns:1.14.2 for Kubernetes 1.36,\n"
  ++ "# RUN_AS_USER/GROUP 1001), and the kube-dns Service at 10.96.0.10 (kubelet's\n"
  ++ "# clusterDNS). To be generated by Bend with laws (TODO: src/guest/coredns.bend).\n"
  ++ "apiVersion: v1\n"
  ++ "kind: ServiceAccount\n"
  ++ "metadata:\n"
  ++ "  name: coredns\n"
  ++ "  namespace: kube-system\n"
  ++ "---\n"
  ++ "apiVersion: rbac.authorization.k8s.io/v1\n"
  ++ "kind: ClusterRole\n"
  ++ "metadata:\n"
  ++ "  labels:\n"
  ++ "    kubernetes.io/bootstrapping: rbac-defaults\n"
  ++ "  name: system:coredns\n"
  ++ "rules:\n"
  ++ "  - apiGroups: [\"\"]\n"
  ++ "    resources: [endpoints, services, pods, namespaces]\n"
  ++ "    verbs: [list, watch]\n"
  ++ "  - apiGroups: [discovery.k8s.io]\n"
  ++ "    resources: [endpointslices]\n"
  ++ "    verbs: [list, watch]\n"
  ++ "---\n"
  ++ "apiVersion: rbac.authorization.k8s.io/v1\n"
  ++ "kind: ClusterRoleBinding\n"
  ++ "metadata:\n"
  ++ "  annotations:\n"
  ++ "    rbac.authorization.kubernetes.io/autoupdate: \"true\"\n"
  ++ "  labels:\n"
  ++ "    kubernetes.io/bootstrapping: rbac-defaults\n"
  ++ "  name: system:coredns\n"
  ++ "roleRef:\n"
  ++ "  apiGroup: rbac.authorization.k8s.io\n"
  ++ "  kind: ClusterRole\n"
  ++ "  name: system:coredns\n"
  ++ "subjects:\n"
  ++ "  - kind: ServiceAccount\n"
  ++ "    name: coredns\n"
  ++ "    namespace: kube-system\n"
  ++ "---\n"
  ++ "apiVersion: v1\n"
  ++ "kind: ConfigMap\n"
  ++ "metadata:\n"
  ++ "  name: coredns\n"
  ++ "  namespace: kube-system\n"
  ++ "data:\n"
  ++ "  Corefile: |-\n"
  ++ "    .:1053 {\n"
  ++ "        errors\n"
  ++ "        health\n"
  ++ "        ready\n"
  ++ "        kubernetes cluster.local in-addr.arpa ip6.arpa {\n"
  ++ "            pods insecure\n"
  ++ "            fallthrough in-addr.arpa ip6.arpa\n"
  ++ "        }\n"
  ++ "        hosts /etc/coredns/NodeHosts {\n"
  ++ "            ttl 60\n"
  ++ "            reload 15s\n"
  ++ "            fallthrough\n"
  ++ "        }\n"
  ++ "        prometheus :9153\n"
  ++ "        forward . /etc/resolv.conf\n"
  ++ "        cache 30\n"
  ++ "        loop\n"
  ++ "        reload\n"
  ++ "        loadbalance\n"
  ++ "    }\n"
  ++ "\n"
  ++ "    import /etc/coredns/custom/*.server\n"
  ++ "  NodeHosts: \"\"\n"
  ++ "---\n"
  ++ "apiVersion: apps/v1\n"
  ++ "kind: Deployment\n"
  ++ "metadata:\n"
  ++ "  name: coredns\n"
  ++ "  namespace: kube-system\n"
  ++ "  labels:\n"
  ++ "    k8s-app: vcluster-kube-dns\n"
  ++ "    kubernetes.io/name: \"CoreDNS\"\n"
  ++ "spec:\n"
  ++ "  replicas: 1\n"
  ++ "  strategy:\n"
  ++ "    type: RollingUpdate\n"
  ++ "    rollingUpdate:\n"
  ++ "      maxUnavailable: 1\n"
  ++ "  selector:\n"
  ++ "    matchLabels:\n"
  ++ "      k8s-app: vcluster-kube-dns\n"
  ++ "  template:\n"
  ++ "    metadata:\n"
  ++ "      labels:\n"
  ++ "        k8s-app: vcluster-kube-dns\n"
  ++ "    spec:\n"
  ++ "      serviceAccountName: coredns\n"
  ++ "      nodeSelector:\n"
  ++ "        kubernetes.io/os: linux\n"
  ++ "      securityContext:\n"
  ++ "        seccompProfile:\n"
  ++ "          type: RuntimeDefault\n"
  ++ "      containers:\n"
  ++ "        - name: coredns\n"
  ++ "          image: coredns/coredns:1.14.2\n"
  ++ "          imagePullPolicy: IfNotPresent\n"
  ++ "          args: [ \"-conf\", \"/etc/coredns/Corefile\" ]\n"
  ++ "          volumeMounts:\n"
  ++ "            - name: config-volume\n"
  ++ "              mountPath: /etc/coredns\n"
  ++ "              readOnly: true\n"
  ++ "            - name: custom-config-volume\n"
  ++ "              mountPath: /etc/coredns/custom\n"
  ++ "              readOnly: true\n"
  ++ "          securityContext:\n"
  ++ "            runAsNonRoot: true\n"
  ++ "            runAsUser: 1001\n"
  ++ "            runAsGroup: 1001\n"
  ++ "            allowPrivilegeEscalation: false\n"
  ++ "            capabilities:\n"
  ++ "              add: [NET_BIND_SERVICE]\n"
  ++ "              drop: [ALL]\n"
  ++ "            readOnlyRootFilesystem: true\n"
  ++ "          livenessProbe:\n"
  ++ "            httpGet: {path: /health, port: 8080, scheme: HTTP}\n"
  ++ "            initialDelaySeconds: 60\n"
  ++ "            periodSeconds: 10\n"
  ++ "            timeoutSeconds: 1\n"
  ++ "            successThreshold: 1\n"
  ++ "            failureThreshold: 3\n"
  ++ "          readinessProbe:\n"
  ++ "            httpGet: {path: /ready, port: 8181, scheme: HTTP}\n"
  ++ "            initialDelaySeconds: 0\n"
  ++ "            periodSeconds: 2\n"
  ++ "            timeoutSeconds: 1\n"
  ++ "            successThreshold: 1\n"
  ++ "            failureThreshold: 3\n"
  ++ "      dnsPolicy: Default\n"
  ++ "      volumes:\n"
  ++ "        - name: config-volume\n"
  ++ "          configMap:\n"
  ++ "            name: coredns\n"
  ++ "            items:\n"
  ++ "              - key: Corefile\n"
  ++ "                path: Corefile\n"
  ++ "              - key: NodeHosts\n"
  ++ "                path: NodeHosts\n"
  ++ "        - name: custom-config-volume\n"
  ++ "          configMap:\n"
  ++ "            name: coredns-custom\n"
  ++ "            optional: true\n"
  ++ "---\n"
  ++ "apiVersion: v1\n"
  ++ "kind: Service\n"
  ++ "metadata:\n"
  ++ "  name: kube-dns\n"
  ++ "  namespace: kube-system\n"
  ++ "  annotations:\n"
  ++ "    prometheus.io/port: \"9153\"\n"
  ++ "    prometheus.io/scrape: \"true\"\n"
  ++ "  labels:\n"
  ++ "    k8s-app: vcluster-kube-dns\n"
  ++ "    kubernetes.io/cluster-service: \"true\"\n"
  ++ "    kubernetes.io/name: \"CoreDNS\"\n"
  ++ "spec:\n"
  ++ "  clusterIP: 10.96.0.10\n"
  ++ "  ports:\n"
  ++ "    - {name: dns, port: 53, targetPort: 1053, protocol: UDP}\n"
  ++ "    - {name: dns-tcp, port: 53, targetPort: 1053, protocol: TCP}\n"
  ++ "    - {name: metrics, port: 9153, protocol: TCP}\n"
  ++ "  selector:\n"
  ++ "    k8s-app: vcluster-kube-dns\n"

# The leading comment lines: YAML comments, not in vcluster's output.
def T.fx.header.from() -> String:
  "# vcluster pkg/coredns/template.go, rendered with the default values\n"
  ++ "# (controlPlane.coredns, image coredns/coredns:1.14.2 for Kubernetes 1.36,\n"
  ++ "# RUN_AS_USER/GROUP 1001), and the kube-dns Service at 10.96.0.10 (kubelet's\n"
  ++ "# clusterDNS). To be generated by Bend with laws (TODO: src/guest/coredns.bend).\n"

def T.fx.header.to() -> String:
  ""

# The ClusterRole rules in flow style; the template writes block lists.
def T.fx.rules.from() -> String:
  "  - apiGroups: [\"\"]\n"
  ++ "    resources: [endpoints, services, pods, namespaces]\n"
  ++ "    verbs: [list, watch]\n"
  ++ "  - apiGroups: [discovery.k8s.io]\n"
  ++ "    resources: [endpointslices]\n"
  ++ "    verbs: [list, watch]\n"

def T.fx.rules.to() -> String:
  "  - apiGroups:\n"
  ++ "      - \"\"\n"
  ++ "    resources:\n"
  ++ "      - endpoints\n"
  ++ "      - services\n"
  ++ "      - pods\n"
  ++ "      - namespaces\n"
  ++ "    verbs:\n"
  ++ "      - list\n"
  ++ "      - watch\n"
  ++ "  - apiGroups:\n"
  ++ "      - discovery.k8s.io\n"
  ++ "    resources:\n"
  ++ "      - endpointslices\n"
  ++ "    verbs:\n"
  ++ "      - list\n"
  ++ "      - watch\n"

# The Corefile's blank line: the template's `indent 4` pads it to four
# spaces (a |- block keeps it an empty line either way).
def T.fx.blank.from() -> String:
  "    }\n"
  ++ "\n"
  ++ "    import /etc/coredns/custom/*.server\n"

def T.fx.blank.to() -> String:
  "    }\n"
  ++ "    \n"
  ++ "    import /etc/coredns/custom/*.server\n"

# priorityClassName: the template always writes it, "" when unset, which
# the API reads as unset.
def T.fx.priority.from() -> String:
  "    spec:\n"
  ++ "      serviceAccountName: coredns\n"

def T.fx.priority.to() -> String:
  "    spec:\n"
  ++ "      priorityClassName: \"\"\n"
  ++ "      serviceAccountName: coredns\n"

# The capabilities in flow style; the template writes block lists.
def T.fx.caps.from() -> String:
  "              add: [NET_BIND_SERVICE]\n"
  ++ "              drop: [ALL]\n"

def T.fx.caps.to() -> String:
  "              add:\n"
  ++ "                - NET_BIND_SERVICE\n"
  ++ "              drop:\n"
  ++ "                - ALL\n"

# The liveness probe in flow style; the template writes a block map.
def T.fx.liveness.from() -> String:
  "            httpGet: {path: /health, port: 8080, scheme: HTTP}\n"

def T.fx.liveness.to() -> String:
  "            httpGet:\n"
  ++ "              path: /health\n"
  ++ "              port: 8080\n"
  ++ "              scheme: HTTP\n"

# The readiness probe in flow style; the template writes a block map.
def T.fx.readiness.from() -> String:
  "            httpGet: {path: /ready, port: 8181, scheme: HTTP}\n"

def T.fx.readiness.to() -> String:
  "            httpGet:\n"
  ++ "              path: /ready\n"
  ++ "              port: 8181\n"
  ++ "              scheme: HTTP\n"

# The Service ports in flow style before the selector; the template
# writes the selector, then the ports as block maps.
def T.fx.ports.from() -> String:
  "  ports:\n"
  ++ "    - {name: dns, port: 53, targetPort: 1053, protocol: UDP}\n"
  ++ "    - {name: dns-tcp, port: 53, targetPort: 1053, protocol: TCP}\n"
  ++ "    - {name: metrics, port: 9153, protocol: TCP}\n"
  ++ "  selector:\n"
  ++ "    k8s-app: vcluster-kube-dns\n"

def T.fx.ports.to() -> String:
  "  selector:\n"
  ++ "    k8s-app: vcluster-kube-dns\n"
  ++ "  ports:\n"
  ++ "    - name: dns\n"
  ++ "      port: 53\n"
  ++ "      targetPort: 1053\n"
  ++ "      protocol: UDP\n"
  ++ "    - name: dns-tcp\n"
  ++ "      port: 53\n"
  ++ "      targetPort: 1053\n"
  ++ "      protocol: TCP\n"
  ++ "    - name: metrics\n"
  ++ "      port: 9153\n"
  ++ "      protocol: TCP\n"

# The rewrites in order, then vcluster's strings.TrimSpace (the file
# ends with a newline).
def T.fx.normalize(s: String) -> String:
  s1 = C.Coredns.replace(s, T.fx.header.from(), T.fx.header.to())
  s2 = C.Coredns.replace(s1, T.fx.rules.from(), T.fx.rules.to())
  s3 = C.Coredns.replace(s2, T.fx.blank.from(), T.fx.blank.to())
  s4 = C.Coredns.replace(s3, T.fx.priority.from(), T.fx.priority.to())
  s5 = C.Coredns.replace(s4, T.fx.caps.from(), T.fx.caps.to())
  s6 = C.Coredns.replace(s5, T.fx.liveness.from(), T.fx.liveness.to())
  s7 = C.Coredns.replace(s6, T.fx.readiness.from(), T.fx.readiness.to())
  s8 = C.Coredns.replace(s7, T.fx.ports.from(), T.fx.ports.to())
  String.trim(s8)

def main() -> IO(Unit):
  do IO<Unit>:
    +dm : String = C.Coredns.default_manifest()
    +custom : String = C.Coredns.render(C.Cfg{"corp.example", "10.43.0.10", "registry.local/coredns:1.14.2", 3, 65532, 65532})
    +fallback : String = C.Coredns.corefile(T.with(["networking", "advanced", "fallbackHostCluster"], J.JBool{True{}}),
      C.Vars{"", "", "", "10.0.0.2"})
    +netpol : String = C.Coredns.corefile(T.with(["policies", "networkPolicy", "enabled"], J.JBool{True{}}), T.no_vars())
    +resolve : String = C.Coredns.corefile(C.Coredns.put(["networking", "resolveDNS"],
      T.with(["controlPlane", "coredns", "embedded"], J.JBool{True{}}),
      J.Json.arr([J.Json.obj([J.KV{"hostname", J.JStr{"a"}}])])), T.no_vars())
    +registry : String = C.Coredns.manifests(C.Coredns.put(["controlPlane", "advanced", "defaultImageRegistry"],
      T.with(["controlPlane", "coredns", "deployment", "image"], J.JStr{"coredns/coredns:x"}), J.JStr{"my.reg"}),
      C.Vars{"ignored", "1", "1", ""})
    +selector : String = C.Coredns.manifests(T.with(["controlPlane", "coredns", "service", "spec"],
      J.Json.obj([J.KV{"type", J.JStr{"ClusterIP"}}, J.KV{"selector", J.Json.obj([J.KV{"app", J.JStr{"x"}}])}])),
      T.no_vars())
    IO.print(T.eq("default: scripts/guest/coredns.yaml, normalized", T.fx.normalize(T.fx.file()), dm))
    IO.print(T.lacks("default: no rewrite rule", dm, "rewrite name regex"))
    IO.print(T.has("default: seccomp from the pod security standard", dm, "seccompProfile:\n          type: RuntimeDefault"))
    IO.print(T.has("default: kube-dns at 10.96.0.10", dm, "spec:\n  clusterIP: 10.96.0.10\n  selector:\n"))
    IO.print(T.has("default: NodeHosts in the hosts plugin", dm, "hosts /etc/coredns/NodeHosts {\n            ttl 60\n"))
    IO.print(T.has("custom: domain before cluster.local", custom, "kubernetes corp.example cluster.local in-addr.arpa ip6.arpa {"))
    IO.print(T.has("custom: replicas", custom, "  replicas: 3\n"))
    IO.print(T.has("custom: image", custom, "          image: registry.local/coredns:1.14.2\n"))
    IO.print(T.has("custom: uid", custom, "            runAsUser: 65532\n"))
    IO.print(T.has("custom: service IP", custom, "spec:\n  clusterIP: 10.43.0.10\n  selector:\n    k8s-app: vcluster-kube-dns\n  ports:\n"))
    IO.print(T.has("fallbackHostCluster forwards to the host DNS", fallback, "    forward . 10.0.0.2\n"))
    IO.print(T.has("fallbackHostCluster falls through cluster.local", fallback, "fallthrough cluster.local in-addr.arpa ip6.arpa"))
    IO.print(T.has("network policy adds the fallback DNS", netpol,
      "    forward . /etc/resolv.conf 8.8.8.8 {\n        policy sequential\n    }\n    cache 30"))
    IO.print(T.has("embedded with resolveDNS adds the vcluster plugin", resolve, "    ready\n    vcluster\n    rewrite"))
    IO.print(T.lacks("embedded drops reload", resolve, "    reload\n"))
    IO.print(T.eq("<no value> removed, output trimmed",
      C.Coredns.manifests(C.Coredns.put(["controlPlane", "coredns", "overwriteManifests"], J.JObj{J.JNil{}},
        J.JStr{"  a<no value>b\n"}), T.no_vars()), "ab"))
    IO.print(T.has("deployment.image under the registry", registry, "          image: my.reg/coredns/coredns:x\n"))
    IO.print(T.has("a spec selector replaces the default", selector, "spec:\n  selector:\n    app: x\n  type: ClusterIP\n  ports:\n"))
    IO.print(T.eq("image for 1.36", C.Coredns.image("1", "36", ""), "docker.io/coredns/coredns:1.14.2"))
    IO.print(T.eq("replace all", C.Coredns.replace("a<no value>b<no value>", "<no value>", ""), "ab"))
    IO.print(T.eq("clean removes every <no value>", C.Coredns.clean("a<no value>b<no value>"), "ab"))
    IO.print(T.eq("clean is one pass, as ReplaceAll", C.Coredns.clean("<no valu<no value>e>"), "<no value>"))
    IO.print(T.eq("join: a --- line between documents", C.Coredns.join(["a", "b", "c"]), "a\n---\nb\n---\nc"))
    IO.print(T.has("default: RBAC documents joined", dm, "  namespace: kube-system\n---\napiVersion: rbac"))
    IO.print(T.has("default: the Deployment's parts joined at the containers", dm,
      "          type: RuntimeDefault\n      containers:\n        - name: coredns\n"))
    IO.print(T.eq("get: a missing key is null", J.Json.show(C.Coredns.at(C.Coredns.vcluster_defaults(), ["x", "y"])), "null"))
    IO.print(T.eq("get: the first member with the key", C.Coredns.text(C.Coredns.get(J.JObj{J.JMem{"k", J.JStr{"1"},
      J.JMem{"k", J.JStr{"2"}, J.JNil{}}}}, "k")), "1"))
    IO.print(T.eq("replace adjacent", C.Coredns.replace("xxxx", "xx", "y"), "yy"))
    IO.print(T.eq("indent pads empty lines", C.Coredns.indent("  ", "a\n\nb"), "  a\n  \n  b"))
    IO.print(T.line("0 is false", Bool.not(C.Coredns.truthy(J.JNum{"0"}))))
    IO.print(T.line("0.0 is false", Bool.not(C.Coredns.truthy(J.JNum{"0.0"}))))
    IO.print(T.line("2 is true", C.Coredns.truthy(J.JNum{"2"})))
    IO.print(T.line("{} is false", Bool.not(C.Coredns.truthy(J.JObj{J.JNil{}}))))
    IO.print(T.yaml("yaml bool word quoted", "true", "\"true\""))
    IO.print(T.yaml("yaml empty quoted", "", "\"\""))
    IO.print(T.yaml("yaml float quoted", "1.5", "\"1.5\""))
    IO.print(T.yaml("yaml IP plain", "10.96.0.10", "10.96.0.10"))
    IO.print(T.yaml("yaml date quoted", "2001-12-14", "\"2001-12-14\""))
    IO.print(T.yaml("yaml quantity plain", "1000m", "1000m"))
    IO.print(T.yaml("yaml hex quoted", "0x1F", "\"0x1F\""))
    IO.print(T.yaml("yaml dash quoted", "-", "\"-\""))
    IO.print(T.eq("yaml sorted keys, lists at the key's indentation",
      C.Coredns.to_yaml(J.Json.obj([J.KV{"b", J.JNum{"1"}}, J.KV{"a", J.Json.arr([J.JStr{"x"},
        J.Json.obj([J.KV{"k", J.JStr{"v"}}, J.KV{"c", J.JBool{False{}}}])])}])),
      "a:\n- x\n- c: false\n  k: v\nb: 1"))
    IO.print(T.eq("yaml empty map", C.Coredns.to_yaml(J.JObj{J.JNil{}}), "{}"))
