import Base
import bend-kube-runtime@0.2.0.0/src/json.bend as J
import ../src/config/vcluster.bend as V

# Tests: config subset at upstream a8ab30ea. Expectations are from
# the upstream source and tests, not from the Bend implementation.

def T.check(+n: String, ok: Bool) -> IO(Unit):
  match ok:
    case True{}:
      IO.print("PASS " ++ n)
    case False{}:
      IO.print("FAIL " ++ n)

def main() -> IO(Unit):
  do IO<Unit>:
    T.check("diff_simple", String.eq(J.Json.show(V.Config.value("sync:\n  toHost:\n    services:\n      enabled: false\n", ["sync", "toHost", "services", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("unknown_yaml", String.eq(V.Config.error("foo:\n  bar: baz\n"), "error unmarshaling JSON: while decoding JSON: json: unknown field \"foo\""))
    T.check("unknown_json", String.eq(V.Config.error("{\"foo\":{\"bar\":\"baz\"}}"), "error unmarshaling JSON: while decoding JSON: json: unknown field \"foo\""))
    T.check("old_format", String.eq(V.Config.error("api:\n  image: registry.k8s.io/kube-apiserver:v1.29.0\ncontroller:\n  image: registry.k8s.io/kube-controller-manager:v1.29.0\netcd:\n  image: registry.k8s.io/etcd:3.5.10-0\nscheduler:\n  image: registry.k8s.io/kube-scheduler:v1.29.0\nservice:\n  type: NodePort\nserviceCIDR: 10.96.0.0/16\nsync:\n  nodes:\n    enabled: true\ntelemetry:\n  disabled: false\n"), "error unmarshaling JSON: while decoding JSON: json: unknown field \"api\""))
    T.check("new_yaml", String.eq(J.Json.show(V.Config.value("controlPlane:\n  distro:\n    k8s:\n      enabled: true\n", ["controlPlane", "distro", "k8s", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("new_json", String.eq(J.Json.show(V.Config.value("{\"controlPlane\":{\"distro\":{\"k8s\":{\"enabled\":true}}}}", ["controlPlane", "distro", "k8s", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("args_sequence", String.eq(J.Json.show(V.Config.value("controlPlane:\n  distro:\n    k8s:\n      apiServer:\n        extraArgs:\n          - --v=3\n          - \"--audit-log-path=/data/a # b\" # comment\n", ["controlPlane", "distro", "k8s", "apiServer", "extraArgs"])), J.Json.show(J.Json.arr([J.JStr{"--v=3"}, J.JStr{"--audit-log-path=/data/a # b"}]))))
    T.check("coredns_replicas", String.eq(J.Json.show(V.Config.value("controlPlane:\n  coredns:\n    enabled: false\n    deployment:\n      replicas: 3\n", ["controlPlane", "coredns", "deployment", "replicas"])), J.Json.show(J.JNum{"3"})))
    T.check("networking", String.eq(J.Json.show(V.Config.value("networking:\n  serviceCIDR: 10.96.0.0/12\n  podCIDR: 10.2.0.0/16\n  advanced:\n    clusterDomain: example.test\n", ["networking", "advanced", "clusterDomain"])), J.Json.show(J.JStr{"example.test"})))
    T.check("standalone", String.eq(J.Json.show(V.Config.value("controlPlane:\n  standalone:\n    enabled: true\n    joinNode:\n      enabled: false\n", ["controlPlane", "standalone", "joinNode", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("storage_both", String.eq(V.Config.error("sync:\n  toHost:\n    storageClasses:\n      enabled: true\n  fromHost:\n    storageClasses:\n      enabled: true\n"), "you cannot enable both sync.fromHost.storageClasses.enabled and sync.toHost.storageClasses.enabled at the same time. Choose only one of them"))
    T.check("priority_both", String.eq(V.Config.error("sync:\n  toHost:\n    priorityClasses:\n      enabled: true\n  fromHost:\n    priorityClasses:\n      enabled: true\n"), "cannot sync priorityclasses to and from host at the same time"))
    T.check("volumeSnapshots_alone", String.eq(V.Config.error("sync:\n  toHost:\n    volumeSnapshots:\n      enabled: true\n"), "when syncing volume snapshots to the host, one must set sync.toHost.volumeSnapshotContents.enabled to true"))
    T.check("volumeSnapshotContents_alone", String.eq(V.Config.error("sync:\n  toHost:\n    volumeSnapshotContents:\n      enabled: true\n"), "when syncing volume snapshots contents to the host, one must set sync.toHost.volumeSnapshots.enabled to true"))
    T.check("scheduler_needs_nodes", String.eq(V.Config.error("controlPlane:\n  distro:\n    k8s:\n      scheduler:\n        enabled: true\n"), "sync.fromHost.nodes.enabled is false, but required if using hybrid scheduling or virtual scheduler"))
    T.check("configMaps_needs_mappings", String.eq(V.Config.error("sync:\n  fromHost:\n    configMaps:\n      enabled: true\n"), "config.sync.fromHost.configMaps.mappings are empty"))
    T.check("secrets_needs_mappings", String.eq(V.Config.error("sync:\n  fromHost:\n    secrets:\n      enabled: true\n"), "config.sync.fromHost.secrets.mappings are empty"))
    T.check("gateway_needs_mappings", String.eq(V.Config.error("sync:\n  fromHost:\n    gateways:\n      enabled: true\n"), "sync.fromHost.gateways.mappings.byName are empty"))
    T.check("namespace_no_mappings", String.eq(V.Config.error("sync:\n  toHost:\n    namespaces:\n      enabled: true\n"), "namespace sync: config.sync.toHost.namespaces.mappings.byName are empty"))
    T.check("namespace_disabled", String.eq(V.Config.error("sync:\n  toHost:\n    namespaces:\n      enabled: false\n"), ""))
    T.check("reference_grants_invalid", String.eq(V.Config.error("sync:\n  toHost:\n    gatewayApi:\n      referenceGrants:\n        enabled: invalid\n"), "sync.toHost.gatewayApi.referenceGrants.enabled must be one of: auto, true, false"))
    T.check("auto_csi", String.eq(J.Json.show(V.Config.value("controlPlane:\n  distro:\n    k8s:\n      scheduler:\n        enabled: true\nsync:\n  fromHost:\n    nodes:\n      enabled: true\n", ["sync", "fromHost", "csiNodes", "enabled"])), J.Json.show(J.JStr{"true"})))
    T.check("sqlite_default", String.eq(V.Config.backing_store(V.Config.value("", [])), "sqlite"))
    T.check("etcd", String.eq(V.Config.backing_store(V.Config.value("controlPlane:\n  backingStore:\n    etcd:\n      embedded:\n        enabled: true\n", [])), "etcd"))
    T.check("etcd_precedence", String.eq(V.Config.backing_store(V.Config.value("controlPlane:\n  backingStore:\n    database:\n      embedded:\n        enabled: true\n    etcd:\n      embedded:\n        enabled: true\n", [])), "etcd"))
    T.check("default_controlPlane_distro_k8s_enabled", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "distro", "k8s", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_controlPlane_distro_k8s_version", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "distro", "k8s", "version"])), J.Json.show(J.JStr{""})))
    T.check("default_controlPlane_distro_k8s_apiServer_enabled", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "distro", "k8s", "apiServer", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("default_controlPlane_distro_k8s_apiServer_extraArgs", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "distro", "k8s", "apiServer", "extraArgs"])), J.Json.show(J.Json.arr([]))))
    T.check("default_controlPlane_distro_k8s_controllerManager_enabled", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "distro", "k8s", "controllerManager", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("default_controlPlane_distro_k8s_controllerManager_extraArgs", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "distro", "k8s", "controllerManager", "extraArgs"])), J.Json.show(J.Json.arr([]))))
    T.check("default_controlPlane_distro_k8s_scheduler_enabled", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "distro", "k8s", "scheduler", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_controlPlane_distro_k8s_scheduler_extraArgs", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "distro", "k8s", "scheduler", "extraArgs"])), J.Json.show(J.Json.arr([]))))
    T.check("default_controlPlane_backingStore_database_embedded_enabled", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "backingStore", "database", "embedded", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_controlPlane_backingStore_etcd_embedded_enabled", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "backingStore", "etcd", "embedded", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_controlPlane_coredns_enabled", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "coredns", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("default_controlPlane_coredns_deployment_replicas", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "coredns", "deployment", "replicas"])), J.Json.show(J.JNum{"1"})))
    T.check("default_controlPlane_standalone_enabled", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "standalone", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_controlPlane_standalone_joinNode_enabled", String.eq(J.Json.show(V.Config.value("", ["controlPlane", "standalone", "joinNode", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("default_networking_serviceCIDR", String.eq(J.Json.show(V.Config.value("", ["networking", "serviceCIDR"])), J.Json.show(J.JStr{""})))
    T.check("default_networking_podCIDR", String.eq(J.Json.show(V.Config.value("", ["networking", "podCIDR"])), J.Json.show(J.JStr{"10.244.0.0/16"})))
    T.check("default_networking_advanced_clusterDomain", String.eq(J.Json.show(V.Config.value("", ["networking", "advanced", "clusterDomain"])), J.Json.show(J.JStr{"cluster.local"})))
    T.check("default_privateNodes_enabled", String.eq(J.Json.show(V.Config.value("", ["privateNodes", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_services_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "services", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("default_sync_toHost_endpoints_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "endpoints", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("default_sync_toHost_endpointSlices_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "endpointSlices", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("default_sync_toHost_persistentVolumeClaims_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "persistentVolumeClaims", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("default_sync_toHost_configMaps_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "configMaps", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("default_sync_toHost_secrets_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "secrets", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("default_sync_toHost_pods_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "pods", "enabled"])), J.Json.show(J.JBool{True{}})))
    T.check("default_sync_toHost_ingresses_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "ingresses", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_priorityClasses_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "priorityClasses", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_networkPolicies_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "networkPolicies", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_volumeSnapshots_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "volumeSnapshots", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_volumeSnapshotContents_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "volumeSnapshotContents", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_podDisruptionBudgets_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "podDisruptionBudgets", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_serviceAccounts_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "serviceAccounts", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_storageClasses_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "storageClasses", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_persistentVolumes_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "persistentVolumes", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_namespaces_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "namespaces", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_resourceClaims_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "resourceClaims", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_resourceClaimTemplates_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "resourceClaimTemplates", "enabled"])), J.Json.show(J.JBool{False{}})))
    T.check("default_sync_toHost_gatewayApi_enabled", String.eq(J.Json.show(V.Config.value("", ["sync", "toHost", "gatewayApi", "enabled"])), J.Json.show(J.JBool{False{}})))
