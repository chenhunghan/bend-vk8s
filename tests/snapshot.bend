import Base
import ../src/lib/sha256.bend as H
import ../src/standalone/snapshot.bend as S

# Tests for src/standalone/snapshot.bend. Expected values are Go's: archive
# digests are sha256 of Go archive/tar output (tar.Header{Typeflag: TypeReg,
# Name: key, Size: len(value), Mode: 0666}, as writeArchiveEntry writes),
# decodes are Go tar.Reader's, the rest is vcluster's code (go test in
# pkg/snapshot) or read from it.

def report(name: String, got: String, want: String, ok: Bool) -> IO(Unit):
  match ok:
    case True{}:
      IO.print("PASS " ++ name)
    case False{}:
      IO.print("FAIL " ++ name ++ ": got " ++ got ++ ", want " ++ want)

def check(name: String, +got: String, +want: String) -> IO(Unit):
  report(name, got, want, String.eq(got, want))

def rec(k: String, v: String) -> S.Snap.Rec:
  S.Rec{S.Snap.b(k), S.Snap.b(v)}

def digest(r: Result<&2, &2, String, List<&2, U32>>) -> String:
  match r:
    case Fail{m}:
      "error: " ++ m
    case Done{+bs}:
      Nat.show(List.length(&2, U32, bs)) ++ " " ++ H.Sha256.hex(H.Sha256.digest(bs))

def recs(rs: List<&2, S.Snap.Rec>) -> String:
  match rs:
    case Nil{}:
      ""
    case Con{S.Rec{k, v}, t}:
      "[" ++ S.Snap.s(k) ++ "=" ++ S.Snap.s(v) ++ "]" ++ recs(t)

def decoded(r: Result<&2, &2, String, List<&2, S.Snap.Rec>>) -> String:
  match r:
    case Fail{m}:
      "error: " ++ m
    case Done{rs}:
      recs(rs)

def roundtrip(r: Result<&2, &2, String, List<&2, U32>>) -> String:
  match r:
    case Fail{m}:
      "error: " ++ m
    case Done{bs}:
      decoded(S.Snap.Tar.decode(bs))

def kind(r: Result<&2, &2, String, S.Snap.Kind>) -> String:
  match r:
    case Fail{m}:
      "error: " ++ m
    case Done{k}:
      S.Snap.Kind.name(k)

def encoded_kind(r: Result<&2, &2, String, List<&2, U32>>) -> String:
  match r:
    case Fail{m}:
      "error: " ++ m
    case Done{bs}:
      kind(S.Snap.kind_of_tar(bs))

def hexv.if(lower: Bool, x: U32) -> U32:
  match lower:
    case True{}:
      (x - 87 : U32)
    case False{}:
      (x - 48 : U32)

def hexv(c: Char) -> U32:
  match c:
    case Chr{+x}:
      hexv.if(U32.is_ge(x, 97), x)

def unhex(s: String) -> +List<U32>:
  match s:
    case SCon{a, SCon{b, t}}:
      (hexv(a) * 16 + hexv(b) : U32) <> unhex(t)
    case _:
      Nil{}

# A Go archive: a GNU long name (FormatGNU), a directory, a PAX global
# header, a symlink, and a file whose PAX path record Go ignores.
def mixed() -> +List<U32>:
  S.Snap.app(unhex(""), S.Snap.zeros(1534n))

def pod_mark(p: Bool) -> String:
  match p:
    case True{}:
      " pod"
    case False{}:
      ""

def puts(ps: List<&2, S.Snap.Put>) -> String:
  match ps:
    case Nil{}:
      ""
    case Con{S.Put{k, v, pod}, t}:
      "[" ++ S.Snap.s(k) ++ pod_mark(pod) ++ "]" ++ puts(t)

def plan(p: S.Snap.Plan) -> String:
  match p:
    case S.Plan{ps, True{}}:
      puts(ps) ++ " compact"
    case S.Plan{ps, False{}}:
      puts(ps)

def muts(ms: List<&2, S.Snap.Mutation>) -> String:
  match ms:
    case Nil{}:
      ""
    case Con{S.MDelete{k}, t}:
      "[delete " ++ S.Snap.s(k) ++ "]" ++ muts(t)
    case Con{S.MDeletePrefix{k}, t}:
      "[delete-prefix " ++ S.Snap.s(k) ++ "]" ++ muts(t)
    case Con{S.MResetPods{}, t}:
      "[reset-pods]" ++ muts(t)

def peer(r: Result<&2, &2, String, S.Snap.Peer>) -> String:
  match r:
    case Fail{m}:
      "error: " ++ m
    case Done{S.Peer{n, u}}:
      n ++ " " ++ u

def args(r: Result<&2, &2, String, S.Snap.Args>) -> String:
  match r:
    case Fail{m}:
      "error: " ++ m
    case Done{S.Args{n, u}}:
      n ++ " " ++ u

def header_hex(r: Result<&2, &2, String, List<&2, U32>>) -> String:
  match r:
    case Fail{m}:
      "error: " ++ m
    case Done{bs}:
      H.Sha256.hex(bs)

def route(r: S.Snap.Route) -> String:
  match r:
    case S.RouteEtcd{}:
      "etcd"
    case S.RouteConvert{}:
      "convert"
    case S.RouteKeyValue{}:
      "kv"

def main() -> IO(Unit):
  do IO<Unit>:
    check("tar one", digest(S.Snap.Tar.encode([rec("/registry/a", "va1")])), "2048 f25b40369823a62735005fb5cad3cac7f178f90239267d17997af5e7b96d7b67")
    check("tar split", digest(S.Snap.Tar.encode([rec("/registry/apiextensions.k8s.io/customresourcedefinitions/" ++ String.repeat("s", 60n) ++ "/x.example.com", "v")])), "2048 f252b2ce5ce4a1e628637bfdefff00e20c3b9f0615531dafd2f419c32adf2583")
    check("tar pax", digest(S.Snap.Tar.encode([rec("/registry/configmaps/default/" ++ String.repeat("c", 120n), "v")])), "3072 1250f82dd5189ad1356e8c1ff844304d6ff3438cae96ddeb9af984fda096d125")
    check("tar non-ascii", digest(S.Snap.Tar.encode([rec("/é", "v")])), "3072 3677b37c99f889a7b49f1aec8f9e0d6fd6ff8244f59303fbcef08870432c56aa")
    check("tar pax record of 99 bytes", digest(S.Snap.Tar.encode([rec("/" ++ String.repeat("é", 44n) ++ "x", "")])), "2560 a40d3fe7b57ba08656b38471f70806caf950dd9e607b5be9178470f221cbc01c")
    check("tar pax record of 101 bytes", digest(S.Snap.Tar.encode([rec("/" ++ String.repeat("é", 45n), "")])), "2560 ea20de6ad8c1bdcf17fe520a269eadcb902392d2d85519633d66646d31a2e9ee")
    check("tar empty key", digest(S.Snap.Tar.encode([rec("", "v")])), "2048 c8ee2bb0b0ea437a829978bb93f98c47be18f72c3326ee5c0d73e88019c79f06")
    check("tar revision (writeKeyValueSnapshot)", digest(S.Snap.Tar.encode([rec("/vcluster/snapshot/revision", "4242"), rec("/registry/a", "va1"), rec("/registry/b", "vb1")])), "4096 56962b62dbbae70931a7ca5728662335d2fd23040ba97bc51218d8764b10fe66")
    check("tar block sizes", digest(S.Snap.Tar.encode([rec("/registry/a", String.repeat("z", 512n)), rec("/registry/b", String.repeat("y", 513n))])), "3584 91c525308ce9afce1ddb2e627b40b7d02dbe872010d9d483e84f556f74451a6e")
    check("tar empty", digest(S.Snap.Tar.encode([])), "1024 5f70bf18a086007016e948b04aed3b82103a36bea41755b6cddfaf10ace3c6ef")
    check("tar pax name cleaned", digest(S.Snap.Tar.encode([rec("/registry/../a//b/./" ++ String.repeat("d", 101n), "x")])), "3072 8142d77176c3f5287d90c390f5c9eb037c87d91ec09d7a23c2bce1f44b38d188")
    check("tar pax name relative", digest(S.Snap.Tar.encode([rec(String.repeat("r", 101n), "x")])), "3072 e2968f7cef17ea00e385226dc4bb1a4efdc7c4613853c3597a56e6e94eacd43e")
    check("tar trailing slash", digest(S.Snap.Tar.encode([rec("/registry/a/", "v")])), "error: archive/tar: cannot encode header: filename may not have trailing slash")
    check("decode one", roundtrip(S.Snap.Tar.encode([rec("/registry/a", "va1")])), "[/registry/a=va1]")
    check("decode revision", roundtrip(S.Snap.Tar.encode([rec("/vcluster/snapshot/revision", "4242"), rec("/registry/a", "va1"), rec("/registry/b", "vb1")])), "[/vcluster/snapshot/revision=4242][/registry/a=va1][/registry/b=vb1]")
    check("decode split", roundtrip(S.Snap.Tar.encode([rec("/registry/apiextensions.k8s.io/customresourcedefinitions/" ++ String.repeat("s", 60n) ++ "/x.example.com", "v")])), "[/registry/apiextensions.k8s.io/customresourcedefinitions/" ++ String.repeat("s", 60n) ++ "/x.example.com=v]")
    check("decode pax", roundtrip(S.Snap.Tar.encode([rec("/registry/configmaps/default/" ++ String.repeat("c", 120n), "v")])), "[/registry/configmaps/default/" ++ String.repeat("c", 120n) ++ "=v]")
    check("decode pax 101", roundtrip(S.Snap.Tar.encode([rec("/" ++ String.repeat("é", 45n), "")])), "[/" ++ S.Snap.s(S.Snap.b(String.repeat("é", 45n))) ++ "=]")
    check("decode block sizes", roundtrip(S.Snap.Tar.encode([rec("/registry/a", String.repeat("z", 512n)), rec("/registry/b", String.repeat("y", 513n))])), "[/registry/a=" ++ String.repeat("z", 512n) ++ "][/registry/b=" ++ String.repeat("y", 513n) ++ "]")
    check("decode Go mixed archive", decoded(S.Snap.Tar.decode(mixed())), "[/registry/" ++ String.repeat("g", 120n) ++ "=hi][config/=][GlobalHead.0.0=][link=][metadata.json={}]")
    check("decode heads 2", decoded(S.Snap.Tar.heads(2n, mixed())), "[/registry/" ++ String.repeat("g", 120n) ++ "=hi][config/=]")
    check("decode zero block then data", decoded(S.Snap.Tar.decode(S.Snap.app(S.Snap.zeros(512n), List.replicate(U32, 512n, 1)))), "error: archive/tar: invalid tar header")
    check("kind of key/value tar", encoded_kind(S.Snap.Tar.encode([rec("/vcluster/snapshot/release", "{}"), rec("/vcluster/snapshot/request/v1beta1", "{}"), rec("/vcluster/snapshot/revision", "7")])), "KeyValueSnapshot")
    check("kind of etcd tar", encoded_kind(S.Snap.Tar.encode([rec("/vcluster/snapshot/release", "{}"), rec("/vcluster/snapshot/request/v1beta1", "{}"), rec("/vcluster/snapshot/db", "db")])), "EtcdSnapshot")
    check("kind of not tar", kind(S.Snap.kind_of_tar(S.Snap.b("this is not a tar stream"))), "error: read tar header: unexpected EOF")
    check("kind of truncated second header", kind(S.Snap.kind_of_tar(List.take(&2, U32, S.Snap.Tar.trailer(), 0n))), "KeyValueSnapshot")
    check("encode key error", digest(S.Snap.encode([rec("/vcluster/snapshot/revision", "1"), rec("/registry/a/", "v")])), "error: failed to snapshot key /registry/a/: archive/tar: cannot encode header: filename may not have trailing slash")
    check("skip keys json", S.Snap.s(S.Snap.skipkeys_json([S.Snap.b("/registry/secrets/ns/b"), S.Snap.b("/registry/configmaps/ns/a<&>"), S.Snap.b("/registry/x\"y\n")])),
      "{\"/registry/configmaps/ns/a\\u003c\\u0026\\u003e\":{},\"/registry/secrets/ns/b\":{},\"/registry/x\\\"y\\n\":{}}")
    check("etcd archive kind", S.Snap.Kind.name(S.Snap.kind(S.Snap.etcd_archive(S.Snap.meta0(), S.Snap.b("db"), Some{[S.Snap.b("/registry/secrets/ns/s")]}))), "EtcdSnapshot")
    check("restore plan", plan(S.Snap.restore_plan([rec("/vcluster/snapshot/revision", "1"), rec("/registry/pods/default/p", "x"),
      rec("/vcluster/mappings/a", "m"), rec("/registry/configmaps/default/kube-root-ca.crt", "c"), rec("/registry/configmaps/kube-root-ca.crt", "c"), rec("/registry/a", "a")], True{}, False{})),
      "[/registry/pods/default/p pod][/registry/configmaps/kube-root-ca.crt][/registry/a] compact")
    check("restore plan private nodes, same vCluster", plan(S.Snap.restore_plan([rec("/registry/pods/default/p", "x"), rec("/vcluster/mappings/a", "m")], False{}, True{})),
      "[/registry/pods/default/p][/vcluster/mappings/a] compact")
    check("restore plan stops at an empty key", plan(S.Snap.restore_plan([rec("/registry/a", "a"), rec("", ""), rec("/registry/b", "b")], False{}, False{})), "[/registry/a] compact")
    check("restore plan of nothing", plan(S.Snap.restore_plan([rec("/vcluster/snapshot/revision", "1")], False{}, False{})), "")
    check("etcd mutations", muts(S.Snap.etcd_mutations([S.Snap.b("/registry/secrets/ns/s")], True{},
      [S.Snap.b("/registry/configmaps/default/kube-root-ca.crt"), S.Snap.b("/registry/configmaps/default/other")], False{})),
      "[delete /registry/secrets/ns/s][delete /registry/configmaps/default/kube-root-ca.crt][delete-prefix /vcluster/mappings/][reset-pods]")
    check("restore route etcd", route(S.Snap.restore_route(S.KEtcd{}, S.EmbeddedEtcd{})), "etcd")
    check("restore route convert", route(S.Snap.restore_route(S.KEtcd{}, S.EmbeddedDatabase{})), "convert")
    check("restore route kv", route(S.Snap.restore_route(S.KKeyValue{}, S.EmbeddedEtcd{})), "kv")
    check("peer standalone", peer(S.Snap.peer(True{}, "10.10.0.2", "vc", "ns")), "10.10.0.2 https://10.10.0.2:2380")
    check("peer standalone without IP", peer(S.Snap.peer(True{}, "", "vc", "ns")), "error: could not determine the IP address for the embedded etcd peer")
    check("peer pod", peer(S.Snap.peer(False{}, "", "vc", "ns")), "vc-0 https://vc-0.vc-headless.ns:2380")
    check("args standalone", args(S.Snap.resolve_args(["s3://b/k"], True{})), " s3://b/k")
    check("args standalone two", args(S.Snap.resolve_args(["a", "b"], True{})), "error: unexpected amount of arguments: 2, need exactly 1 argument. E.g. vcluster [snapshot|restore] s3://my-bucket/my-key/snapshot1.tar.gz --standalone")
    check("args", args(S.Snap.resolve_args(["vc"], False{})), "error: unexpected amount of arguments: 1, need exactly 2 arguments. E.g. vcluster [snapshot|restore] my-vcluster s3://my-bucket/my-key/snapshot1.tar.gz")
    # Fixed Go archive/tar vectors from laws/snapshot.bend, without payload.
    check("file header", header_hex(S.Snap.Tar.file_header(S.Snap.b("/registry/a"), 3n)),
      "")
    check("file header pax", header_hex(S.Snap.Tar.file_header(S.Snap.b("/é"), 1n)),
      "")
    check("pad after", Nat.show(S.Snap.Tar.pad_after(1000n)), "24")
