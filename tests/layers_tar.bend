import Base
import ../src/layers/tar.bend as L

# Tests for src/layers/tar.bend. Tar vectors are Python 3 tarfile output
# (laws/layers_tar.bend has the same ones); hashed host names are Python
# hashlib digests.

def report(name: String, got: String, want: String, ok: Bool) -> IO(Unit):
  match ok:
    case True{}:
      IO.print("PASS " ++ name)
    case False{}:
      IO.print("FAIL " ++ name ++ ": got " ++ got ++ ", want " ++ want)

def check(name: String, +got: String, +want: String) -> IO(Unit):
  report(name, got, want, String.eq(got, want))

def T.hexv.if(lower: Bool, x: U32) -> U32:
  match lower:
    case True{}:
      (x - 87 : U32)
    case False{}:
      (x - 48 : U32)

def T.hexv(c: Char) -> U32:
  match c:
    case Chr{+x}:
      T.hexv.if(U32.is_ge(x, 97), x)

def T.unhex(s: String) -> +List<U32>:
  match s:
    case SCon{a, SCon{b, t}}:
      (T.hexv(a) * 16 + T.hexv(b) : U32) <> T.unhex(t)
    case _:
      Nil{}

def T.pad(+bs: +List<U32>) -> +List<U32>:
  List.append(&2, U32, bs, List.replicate(U32, Nat.sub(512n, List.length(&2, U32, bs)), 0))

def T.tar(bs: List<&2, String>) -> +List<U32>:
  match bs:
    case Nil{}:
      Nil{}
    case Con{b, t}:
      List.append(&2, U32, T.pad(T.unhex(b)), T.tar(t))

def T.hosts(es: List<&2, L.Ent>) -> List<&2, String>:
  match es:
    case Nil{}:
      Nil{}
    case Con{e, t}:
      Con{L.Ent.host(e), T.hosts(t)}

def T.plan(r: Result<&2, &2, String, List<&2, L.Ent>>) -> String:
  match r:
    case Fail{e}:
      "refused"
    case Done{es}:
      String.join(T.hosts(es), " ")

def T.step(s: L.Step) -> String:
  match s:
    case L.SEnd{}:
      "end"
    case L.SBad{w}:
      "bad"
    case _:
      "other"

def T.basic() -> +List<U32>:
  T.tar([
    "",
    "",
    "3132372e302e302e31206c6f63616c686f73740a",
    "",
    "",
    "",
    ""])

def T.case() -> +List<U32>:
  T.tar([
    "",
    "",
    ""])

def T.symlink() -> +List<U32>:
  T.tar([
    "",
    ""])

def T.dotdot() -> +List<U32>:
  T.tar([
    ""])

def main() -> IO(Unit):
  do IO<Unit>:
    check("basic hosts", T.plan(L.Tar.plan(T.basic())), "etc etc/hosts etc/mtab etc/hosts2 dev dev/null run run/initctl")
    check("case-folded and reserved names hashed", T.plan(L.Tar.plan(T.case())), "Makefile .bend-beda42571c095172ab63437d050612a5 .bend-10fef46313d579fa57f0a0237c69a572")
    check("symlink escape refused", T.plan(L.Tar.plan(T.symlink())), "refused")
    check("dot dot refused", T.plan(L.Tar.plan(T.dotdot())), "refused")
    check("zero block ends", T.step(L.Tar.head(L.Tar.start(), T.pad(Nil{}))), "end")
    check("garbage header refused", T.step(L.Tar.head(L.Tar.start(), T.pad([1, 2, 3]))), "bad")
    check("hashed name", L.Tar.hashed("makefile"), ".bend-beda42571c095172ab63437d050612a5")
