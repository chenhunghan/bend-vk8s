import Base
import ../src/cli/assets.bend as A
import ../src/cli/manifest.bend as M

# Spec for src/cli/manifest.bend (generated by scripts/release-assets.sh):
# the four guest archives, each pinned by a full SHA-256 digest.

law manifest.four_archives:
  {List.length(&2, A.AssetFile, M.Manifest.files()) == 4n : Nat}

law manifest.pinned:
  {A.Assets.pinned(M.Manifest.files()) == True{} : Bool}
