import Base
import ../src/layers/tar.bend as T
import ../src/oci/size.bend as N

# Spec for src/layers/tar.bend: the unpack plan of an OCI image layer.
# What each entry becomes is containerd's archive.Apply with
# OverlayConvertWhiteout (pkg/archive/tar.go, tar_opts_linux.go) over Go's
# archive/tar; refusals and host names are user decisions of 2026-11-17
# (refuse "..", absolute names and symlink escapes; host names unique on
# a case-insensitive, normalization-insensitive APFS). Tar vectors are
# Python 3 tarfile output (USTAR, PAX and GNU formats), as hex blocks
# without their trailing zeros; hashed host names are Python hashlib
# sha256 hex digests.

# Fixtures
# --------

def layers_tar.fx.hexv.if(lower: Bool, x: U32) -> U32:
  match lower:
    case True{}:
      (x - 87 : U32)
    case False{}:
      (x - 48 : U32)

def layers_tar.fx.hexv(c: Char) -> U32:
  match c:
    case Chr{+x}:
      layers_tar.fx.hexv.if(U32.is_ge(x, 97), x)

# The bytes of a hex string.
def layers_tar.fx.unhex(s: String) -> +List<U32>:
  match s:
    case SCon{a, SCon{b, t}}:
      (layers_tar.fx.hexv(a) * 16 + layers_tar.fx.hexv(b) : U32) <> layers_tar.fx.unhex(t)
    case _:
      Nil{}

# A 512-byte block: the bytes, then zeros.
def layers_tar.fx.pad(+bs: +List<U32>) -> +List<U32>:
  List.append(&2, U32, bs, List.replicate(U32, Nat.sub(512n, List.length(&2, U32, bs)), 0))

def layers_tar.fx.tar(bs: List<&2, String>) -> +List<U32>:
  match bs:
    case Nil{}:
      Nil{}
    case Con{b, t}:
      List.append(&2, U32, layers_tar.fx.pad(layers_tar.fx.unhex(b)), layers_tar.fx.tar(t))

def layers_tar.fx.refused(r: Result<&2, &2, String, List<&2, T.Ent>>) -> Bool:
  match r:
    case Fail{e}:
      True{}
    case Done{x}:
      False{}

def layers_tar.fx.bad(p: T.Path) -> Bool:
  match p:
    case T.PBad{w}:
      True{}
    case _:
      False{}

def layers_tar.fx.mbad(m: T.Mark) -> Bool:
  match m:
    case T.MBad{w}:
      True{}
    case _:
      False{}

# An entry with no xattrs, link or data.
def layers_tar.fx.e(path: String, host: String, ty: T.Ty, mode: U32, uid: U32, gid: U32, mtime: U32) -> T.Ent:
  T.Ent{path, host, ty, mode, uid, gid, 0, 0, mtime, 0, Nil{}, "", N.Size{0, 0}}

# A directory created because an entry needs it.
def layers_tar.fx.implicit(+path: String) -> T.Ent:
  T.Ent{path, path, T.TDir{}, 493, 0, 0, 0, 0, 0, 0, Nil{}, "", N.Size{0, 0}}

# etc/, etc/hosts (20 bytes), symlink etc/mtab, hard link etc/hosts2, char device dev/null 1,3, FIFO run/initctl (USTAR).
def layers_tar.fx.basic() -> +List<U32>:
  layers_tar.fx.tar([
    "",
    "",
    "3132372e302e302e31206c6f63616c686f73740a",
    "",
    "",
    "",
    ""
  ])

# a.bin, uid/gid 1000, pax mtime=1700000000.5 and SCHILY.xattr.user.test=hi (PAX).
def layers_tar.fx.pax() -> +List<U32>:
  layers_tar.fx.tar([
    "",
    "3232206d74696d653d313730303030303030302e350a323920534348494c592e78617474722e757365722e746573743d68690a",
    "",
    "616263"
  ])

# d/ and 118 x: a GNU long name (GNU).
def layers_tar.fx.gnu_long() -> +List<U32>:
  layers_tar.fx.tar([
    "",
    "642f78787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878787878",
    ""
  ])

# 60 p / 60 q / 50 f: a USTAR prefix (USTAR).
def layers_tar.fx.ustar_prefix() -> +List<U32>:
  layers_tar.fx.tar([
    ""
  ])

# a/, a/.wh..wh..opq, .wh.gone owned by 7:8 (USTAR).
def layers_tar.fx.whiteout() -> +List<U32>:
  layers_tar.fx.tar([
    "",
    "",
    ""
  ])

# Makefile, makefile, .bend-meta (USTAR).
def layers_tar.fx.case() -> +List<U32>:
  layers_tar.fx.tar([
    "",
    "",
    ""
  ])

# ./ and ./bin/sh (USTAR).
def layers_tar.fx.root() -> +List<U32>:
  layers_tar.fx.tar([
    "",
    ""
  ])

# ../evil (USTAR).
def layers_tar.fx.dotdot() -> +List<U32>:
  layers_tar.fx.tar([
    ""
  ])

# /etc/passwd (USTAR).
def layers_tar.fx.abs() -> +List<U32>:
  layers_tar.fx.tar([
    ""
  ])

# symlink a -> /etc, then a/passwd (USTAR).
def layers_tar.fx.symlink_escape() -> +List<U32>:
  layers_tar.fx.tar([
    "",
    ""
  ])

# hard link b -> a, without a (USTAR).
def layers_tar.fx.hard_missing() -> +List<U32>:
  layers_tar.fx.tar([
    ""
  ])

# f twice (USTAR).
def layers_tar.fx.dup() -> +List<U32>:
  layers_tar.fx.tar([
    "",
    ""
  ])

# d/ (0755, 1700000000), then d/ again (0700, 1700000001) (USTAR).
def layers_tar.fx.dir_twice() -> +List<U32>:
  layers_tar.fx.tar([
    "",
    ""
  ])
# The dup fixture's first block with its name changed and its checksum not.
def layers_tar.fx.bad_cks() -> +List<U32>:
  layers_tar.fx.tar([""])

# Entries
# -------

# USTAR: a directory, a file and its data length, a symlink with its
# target as written, a hard link naming its target's host path, a char
# device with its numbers, a FIFO; dev and run are not in the archive,
# so they are created (mkparent: 0755).
law layers_tar.basic:
  {T.Tar.plan(layers_tar.fx.basic()) == Done{[
    layers_tar.fx.e("etc", "etc", T.TDir{}, 493, 0, 0, 1700000000),
    T.Ent{"etc/hosts", "etc/hosts", T.TReg{}, 420, 0, 0, 0, 0, 1700000000, 0, Nil{}, "", N.Size{0, 20}},
    T.Ent{"etc/mtab", "etc/mtab", T.TSym{}, 511, 0, 0, 0, 0, 1700000000, 0, Nil{}, "/proc/mounts", N.Size{0, 0}},
    T.Ent{"etc/hosts2", "etc/hosts2", T.THard{}, 420, 0, 0, 0, 0, 1700000000, 0, Nil{}, "etc/hosts", N.Size{0, 0}},
    layers_tar.fx.implicit("dev"),
    T.Ent{"dev/null", "dev/null", T.TChr{}, 438, 0, 0, 1, 3, 1700000000, 0, Nil{}, "", N.Size{0, 0}},
    layers_tar.fx.implicit("run"),
    layers_tar.fx.e("run/initctl", "run/initctl", T.TFifo{}, 384, 0, 0, 1700000000)]}
    : Result<&2, &2, String, List<&2, T.Ent>>}

# PAX: mtime with nanoseconds (Go parsePAXTime: 0.5 s is 500000000 ns)
# and SCHILY.xattr.* as extended attributes (containerd setxattr).
law layers_tar.pax:
  {T.Tar.plan(layers_tar.fx.pax()) == Done{[
    T.Ent{"a.bin", "a.bin", T.TReg{}, 420, 1000, 1000, 0, 0, 1700000000, 500000000, [T.Xattr{"user.test", "hi"}], "", N.Size{0, 3}}]}
    : Result<&2, &2, String, List<&2, T.Ent>>}

# GNU: the long name (type L) replaces the truncated one.
law layers_tar.gnu_long_name:
  {T.Tar.plan(layers_tar.fx.gnu_long()) == Done{[
    layers_tar.fx.implicit("d"),
    layers_tar.fx.e("d/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", "d/xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx", T.TReg{}, 420, 0, 0, 1700000000)]}
    : Result<&2, &2, String, List<&2, T.Ent>>}

# USTAR: the prefix field and the name join with "/".
law layers_tar.ustar_prefix:
  {T.Tar.plan(layers_tar.fx.ustar_prefix()) == Done{[
    layers_tar.fx.implicit("pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp"),
    layers_tar.fx.implicit("pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp/qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq"),
    layers_tar.fx.e("pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp/qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq/ffffffffffffffffffffffffffffffffffffffffffffffffff", "pppppppppppppppppppppppppppppppppppppppppppppppppppppppppppp/qqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqqq/ffffffffffffffffffffffffffffffffffffffffffffffffff", T.TReg{}, 420, 0, 0, 1700000000)]}
    : Result<&2, &2, String, List<&2, T.Ent>>}

# OverlayConvertWhiteout: .wh..wh..opq makes its directory opaque;
# .wh.NAME is a whiteout of NAME, owned as the whiteout file.
law layers_tar.whiteouts:
  {T.Tar.plan(layers_tar.fx.whiteout()) == Done{[
    layers_tar.fx.e("a", "a", T.TDir{}, 493, 0, 0, 1700000000),
    layers_tar.fx.e("a", "a", T.TOpq{}, 420, 0, 0, 1700000000),
    layers_tar.fx.e("gone", "gone", T.TWh{}, 420, 7, 8, 1700000000)]}
    : Result<&2, &2, String, List<&2, T.Ent>>}

# Host names (user decision 2026-11-17): the second of two names equal
# after case folding, and .bend-meta, get ".bend-" and 32 hex digits of
# their SHA-256 (hashlib: sha256(b"makefile"), sha256(b".bend-meta")).
law layers_tar.host_names:
  {T.Tar.plan(layers_tar.fx.case()) == Done{[
    layers_tar.fx.e("Makefile", "Makefile", T.TReg{}, 420, 0, 0, 1700000000),
    layers_tar.fx.e("makefile", ".bend-beda42571c095172ab63437d050612a5", T.TReg{}, 420, 0, 0, 1700000000),
    layers_tar.fx.e(".bend-meta", ".bend-10fef46313d579fa57f0a0237c69a572", T.TReg{}, 420, 0, 0, 1700000000)]}
    : Result<&2, &2, String, List<&2, T.Ent>>}

# containerd skips the root ("resolved to root"); "./" parts go (Clean).
law layers_tar.root_skipped:
  {T.Tar.plan(layers_tar.fx.root()) == Done{[
    layers_tar.fx.implicit("bin"),
    layers_tar.fx.e("bin/sh", "bin/sh", T.TReg{}, 493, 0, 0, 1700000000)]}
    : Result<&2, &2, String, List<&2, T.Ent>>}

# containerd merges a directory given twice; the last attributes win.
law layers_tar.dir_twice:
  {T.Tar.plan(layers_tar.fx.dir_twice()) == Done{[
    layers_tar.fx.e("d", "d", T.TDir{}, 493, 0, 0, 1700000000),
    layers_tar.fx.e("d", "d", T.TDir{}, 448, 0, 0, 1700000001)]}
    : Result<&2, &2, String, List<&2, T.Ent>>}

# Names as filepath.Clean reads them.
law layers_tar.path_clean:
  {T.Tar.path("./a//b/.") == T.POk{["a", "b"]} : T.Path}

law layers_tar.path_root:
  {T.Tar.path("./") == T.PRoot{} : T.Path}

# Refusals (user decision 2026-11-17)
# -----------------------------------

law layers_tar.refuse_dotdot:
  {layers_tar.fx.refused(T.Tar.plan(layers_tar.fx.dotdot())) == True{} : Bool}

law layers_tar.refuse_absolute:
  {layers_tar.fx.refused(T.Tar.plan(layers_tar.fx.abs())) == True{} : Bool}

# A symlink "a" then "a/passwd" would write through the link.
law layers_tar.refuse_symlink_escape:
  {layers_tar.fx.refused(T.Tar.plan(layers_tar.fx.symlink_escape())) == True{} : Bool}

# A hard link names an earlier entry of the layer.
law layers_tar.refuse_hard_link_outside:
  {layers_tar.fx.refused(T.Tar.plan(layers_tar.fx.hard_missing())) == True{} : Bool}

# overlay's mknod or a second create would fail on the same name.
law layers_tar.refuse_duplicate:
  {layers_tar.fx.refused(T.Tar.plan(layers_tar.fx.dup())) == True{} : Bool}

# Go archive/tar: a header whose checksum does not match is ErrHeader.
law layers_tar.refuse_bad_checksum:
  {layers_tar.fx.refused(T.Tar.plan(layers_tar.fx.bad_cks())) == True{} : Bool}

# containerd validateWhiteout: a whiteout must name an entry of its
# directory.
law layers_tar.refuse_whiteout_dot:
  {layers_tar.fx.mbad(T.Tar.mark(["a", ".wh.."])) == True{} : Bool}

law layers_tar.refuse_whiteout_dotdot:
  {layers_tar.fx.mbad(T.Tar.mark(["a", ".wh..."])) == True{} : Bool}

# For every name, an absolute one is refused.
law layers_tar.absolute_never:
  for +s: String
  {layers_tar.fx.bad(T.Tar.path("/" ++ s)) == True{} : Bool}

# Host names (user decision 2026-11-17)
# -------------------------------------

# No name starting ".bend-" keeps itself on the host, so none can be
# .bend-meta or a hashed name.
law layers_tar.reserved_prefix_hashed:
  for s: String
  {T.Tar.plain_ok(".bend-" ++ s) == False{} : Bool}

# A name with a byte of 128 or more never keeps itself on the host
# (APFS refuses names that are not UTF-8 and folds Unicode).
law layers_tar.non_ascii_hashed:
  for s: String
  {T.Tar.plain_ok(SCon{Chr{200}, s}) == False{} : Bool}

# Every hashed name starts with ".bend-".
law layers_tar.hashed_prefix:
  for s: String
  {String.starts_with(T.Tar.hashed(s), ".bend-") == True{} : Bool}
