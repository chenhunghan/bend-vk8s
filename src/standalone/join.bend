import Base
import bend-kube-runtime@0.2.0.0/src/json.bend as J
import bend-kube-runtime@0.2.0.0/src/base64.bend as B
import bend-kube-runtime@0.2.0.0/src/utf8.bend as U
import bend-kube-runtime@0.2.0.0/src/time.bend as T
import ../lib/sha256.bend as H

# The private-nodes / standalone join flow, as pure decisions: kubeadm
# bootstrap tokens, the token Secret, the `vcluster token create` output,
# the /node/join request, its authorization, and the join script vk8s
# serves.
#
# Sources (vcluster a8ab30e and its pinned Kubernetes v1.36.3):
# - cmd/vclusterctl/cmd/token/create.go: the token Secret, the printed
#   join command and the CA cert hash (pubkeypin.Hash of kube-root-ca.crt).
# - pkg/cli/create_docker.go:738-749: the docker driver's worker join.
# - k8s.io/cluster-bootstrap token/util and util/secrets: token format,
#   secret names, groups, usages, expiration.
# - plugin/pkg/auth/authenticator/token/bootstrap: how kube-apiserver
#   authenticates a bootstrap token against its Secret.
# - cmd/kubeadm/app/util/pubkeypin: the discovery CA cert hash.
# - Go net/url (QueryEscape, QueryUnescape, ParseQuery) and time
#   (RFC 3339 parsing).
#
# The /node/join handler and the script it serves are closed source
# (vcluster-pro). Join.authorize and Join.script are vk8s's design,
# recorded in docs/ref/standalone-decisions.md.
#
# Kept as vcluster does it:
# - `vcluster token create` prints /node/join?token=<t> with no type; the
#   docker driver adds &type=worker. The node type of a token is its
#   Secret's vcluster.loft.sh/token-node-type label.
# - The Secret's description is "token generated by
#   cluster-api-bootstrap-provider-kubeadm" (create.go copies it from
#   cluster-api).
#
# Limits:
# - Times keep whole seconds: an RFC 3339 fraction is dropped, so a token
#   whose expiration has a fraction expires up to one second early.
# - RFC 3339 parsing is Go's fast path (parseRFC3339); forms only the slow
#   layout parser accepts (a "," before the fraction) count as
#   unparseable, so the token counts as expired.
# - A TTL is whole seconds below 2^32 minus one day.

# A bootstrap token, split at its dot: "<id>.<secret>".
type Join.Token is Data:
  Token{id: String, secret: String}

# An instant in UTC: days since -0400-03-01 and the second of the day.
type Join.Time is Data:
  Time{days: U32, secs: U32}

# The user a bootstrap token authenticates as (user.DefaultInfo).
type Join.User is Data:
  User{name: String, groups: List<&2, String>}

# The query of a /node/join request: the token and the node type asked
# for ("" when the request names none).
type Join.Query is Data:
  Query{token: String, node_type: String}

# A /node/join request target, parsed: its query, or the HTTP status and
# message to answer.
type Join.Req is Data:
  ReqOk{query: Join.Query}
  ReqErr{code: U32, msg: String}

# The decision on a join request: the user and the node type to join as,
# or the HTTP status and the reason (Join.respond sends it as the body).
type Join.Auth is Data:
  Allowed{user: Join.User, node_type: String}
  Denied{code: U32, reason: String}

# A key and a value of a URL query.
type Join.Param is Data:
  Param{key: String, value: String}

# url.ParseQuery: the pairs in order, and whether every segment parsed
# (Go still returns the pairs that did when it reports an error).
type Join.Values is Data:
  Values{params: List<&2, Join.Param>, ok: Bool}

# One segment of a query: skipped (empty), an error, or a pair.
type Join.Seg is Data:
  SegSkip{}
  SegErr{}
  SegOk{param: Join.Param}

# A string cut at the first separator: before, after, and whether the
# separator was there.
type Join.Cut is Data:
  Cut{before: String, after: String, found: Bool}

# The state of QueryUnescape between chars: plain text, after a "%",
# after "%" and one hex digit, or broken.
type Join.Esc is Data:
  EscPlain{}
  EscHi{}
  EscLo{hi: U32}
  EscBad{}

# The CA cert hash for kubeadm discovery, or the error.
type Join.Hash is Data:
  HashOk{hash: String}
  HashErr{msg: String}

# A DER header: its tag, its length and the length of its contents.
type Join.Tlv is Data:
  Tlv{tag: U32, hlen: Nat, len: Nat}

# Where a PEM reader is: outside a block, or inside one with its body so far.
type Join.PemSt is Data:
  PemOut{}
  PemIn{body: String}

# A PEM line: the BEGIN or END of a CERTIFICATE block, or anything else.
type Join.PemLine is Data:
  PemBegin{}
  PemEnd{}
  PemOther{}

# What the join script needs: the API endpoint (host:port), the token, the
# CA cert hash ("sha256:<hex>") and the node type.
type Join.Script is Data:
  Script{endpoint: String, token: String, ca_hash: String, node_type: String}

# A /node/join answer: the HTTP status, the content type and the body.
type Join.Reply is Data:
  Reply{code: U32, ctype: String, body: String}

# Small helpers.

def Join.pick_str(b: Bool, x: String, y: String) -> String:
  match b:
    case True{}:
      x
    case False{}:
      y

def Join.keep_if(ok: Bool, x: String) -> Maybe<&2, String>:
  match ok:
    case True{}:
      Some{x}
    case False{}:
      None{}

def Join.char_is(m: Maybe<&2, Char>, +x: U32) -> Bool:
  match m:
    case None{}:
      False{}
    case Some{Chr{c}}:
      U32.is_eq(c, x)

# Whether s[i] has code x.
def Join.char_at(+s: String, i: Nat, +x: U32) -> Bool:
  Join.char_is(String.get(s, i), x)

def Join.sub(+s: String, i: Nat, n: Nat) -> String:
  String.take(String.drop(s, i), n)

# Constants (cluster-bootstrap token/api, vcluster pkg/constants/cli.go).

def Join.secret_prefix() -> String:
  "bootstrap-token-"

def Join.secret_type() -> String:
  "bootstrap.kubernetes.io/token"

def Join.default_group() -> String:
  "system:bootstrappers"

def Join.token_label() -> String:
  "vcluster.loft.sh/token"

def Join.node_type_label() -> String:
  "vcluster.loft.sh/token-node-type"

# constants.NodeTypeControlPlane or constants.NodeTypeWorker.
def Join.node_type(cp: Bool) -> String:
  match cp:
    case True{}:
      "control-plane"
    case False{}:
      "worker"

# Bootstrap tokens (k8s.io/cluster-bootstrap/token/util).

# [a-z0-9]
def Join.tok_char(c: Char) -> Bool:
  match c:
    case Chr{+x}:
      (U32.is_ge(x, 48) && U32.is_le(x, 57)) || (U32.is_ge(x, 97) && U32.is_le(x, 122))

def Join.all_tok(s: String) -> Bool:
  match s:
    case SNil{}:
      True{}
    case SCon{c, t}:
      Join.tok_char(c) && Join.all_tok(t)

def Join.is_dot(c: Char) -> Bool:
  match c:
    case Chr{x}:
      U32.is_eq(x, 46)

# Exactly n chars of [a-z0-9] and nothing after.
def Join.valid.sec(n: Nat, s: String) -> Bool:
  match n s:
    case 0n SNil{}:
      True{}
    case 0n SCon{c, t}:
      False{}
    case 1n+p SNil{}:
      False{}
    case 1n+p SCon{c, t}:
      Join.tok_char(c) && Join.valid.sec(p, t)

# Exactly n chars of [a-z0-9], a dot, then 16 chars of [a-z0-9].
def Join.valid.id(n: Nat, s: String) -> Bool:
  match n s:
    case 0n SNil{}:
      False{}
    case 0n SCon{c, t}:
      Join.is_dot(c) && Join.valid.sec(16n, t)
    case 1n+p SNil{}:
      False{}
    case 1n+p SCon{c, t}:
      Join.tok_char(c) && Join.valid.id(p, t)

# IsValidBootstrapToken: \A([a-z0-9]{6})\.([a-z0-9]{16})\z.
def Join.valid_token(s: String) -> Bool:
  Join.valid.id(6n, s)

# IsValidBootstrapTokenID: \A([a-z0-9]{6})\z.
def Join.valid_token_id(s: String) -> Bool:
  Join.valid.sec(6n, s)

# TokenFromIDAndSecret.
def Join.token_from(id: String, secret: String) -> String:
  id ++ "." ++ secret

# BootstrapTokenSecretName.
def Join.secret_name(id: String) -> String:
  Join.secret_prefix() ++ id

def Join.token_id(t: Join.Token) -> String:
  match t:
    case Token{id, secret}:
      id

# tokens.ParseToken: the id and the secret of a valid token.
def Join.parse_token.ok(ok: Bool, +s: String) -> Maybe<&2, Join.Token>:
  match ok:
    case True{}:
      Some{Token{String.take(s, 6n), String.drop(s, 7n)}}
    case False{}:
      None{}

def Join.parse_token(+s: String) -> Maybe<&2, Join.Token>:
  Join.parse_token.ok(Join.valid_token(s), s)

# secrets.ParseName: the token id of a Secret named
# ^bootstrap-token-([a-z0-9]{6})$.
def Join.parse_secret_name(+n: String) -> Maybe<&2, String>:
  Join.keep_if(String.starts_with(n, Join.secret_prefix()) && Join.valid.sec(6n, String.drop(n, 16n)),
    String.drop(n, 16n))

# Generating a token (GenerateBootstrapToken). The host draws one random
# U32 per char (22 of them); each picks validBootstrapTokenChars[r % 36], as
# Go's rand.Int(36) picks an index. A missing value counts as 0.

def Join.alphabet() -> String:
  "0123456789abcdefghijklmnopqrstuvwxyz"

def Join.pick.sel(b: Bool, c: Char, r: Char) -> Char:
  match b:
    case True{}:
      c
    case False{}:
      r

# The k-th char of s; '0' past its end.
def Join.pick.at(s: String, +k: U32) -> Char:
  match s:
    case SNil{}:
      '0'
    case SCon{c, t}:
      Join.pick.sel(U32.is_eq(k, 0), c, Join.pick.at(t, U32.sub(k, 1)))

def Join.pick(+r: U32) -> Char:
  Join.pick.at(Join.alphabet(), U32.mod(r, 36))

def Join.head0(rs: List<&2, U32>) -> U32:
  match rs:
    case Nil{}:
      0
    case Con{h, t}:
      h

def Join.tail0(rs: List<&2, U32>) -> List<&2, U32>:
  match rs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      t

# n token chars from rs, then tail (randBytes).
def Join.chars(n: Nat, +rs: List<&2, U32>, tail: String) -> String:
  match n:
    case 0n:
      tail
    case 1n+p:
      SCon{Join.pick(Join.head0(rs)), Join.chars(p, Join.tail0(rs), tail)}

# GenerateBootstrapToken: 6 chars, a dot, 16 chars.
def Join.generate(+rs: List<&2, U32>) -> String:
  Join.chars(6n, rs, SCon{'.', Join.chars(16n, List.drop(&2, U32, rs, 6n), SNil{})})

# Groups and usages.

def Join.group_char(+c: Char) -> Bool:
  Join.tok_char(c) || Join.char_is(Some{c}, 58) || Join.char_is(Some{c}, 45)

def Join.all_group(s: String) -> Bool:
  match s:
    case SNil{}:
      True{}
    case SCon{c, t}:
      Join.group_char(c) && Join.all_group(t)

def Join.first_tok(s: String) -> Bool:
  match s:
    case SNil{}:
      False{}
    case SCon{c, t}:
      Join.tok_char(c)

def Join.group_rest(+r: String) -> Bool:
  Nat.is_le(1n, String.length(r)) && Nat.is_le(String.length(r), 256n) && Join.all_group(r)
    && Join.first_tok(String.reverse(r))

# ValidateBootstrapGroupName:
# \Asystem:bootstrappers:[a-z0-9:-]{0,255}[a-z0-9]\z.
def Join.valid_group(+g: String) -> Bool:
  String.starts_with(g, "system:bootstrappers:") && Join.group_rest(String.drop(g, 21n))

def Join.all_valid_groups(gs: List<&2, String>) -> Bool:
  match gs:
    case Nil{}:
      True{}
    case Con{g, t}:
      Join.valid_group(g) && Join.all_valid_groups(t)

# x into a sorted list without duplicates (sets.String.List order).
def Join.insert.go(c: Cmp, +x: String, +h: String, +t: List<&2, String>, rec: List<&2, String>) -> List<&2, String>:
  match c:
    case LT{}:
      x <> h <> t
    case EQ{}:
      h <> t
    case GT{}:
      h <> rec

def Join.insert(+x: String, xs: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}:
      [x]
    case Con{+h, +t}:
      Join.insert.go(String.order(x, h), x, h, t, Join.insert(x, t))

def Join.sort_uniq(xs: List<&2, String>) -> List<&2, String>:
  match xs:
    case Nil{}:
      Nil{}
    case Con{h, t}:
      Join.insert(h, Join.sort_uniq(t))

def Join.known_usage(+u: String) -> Bool:
  String.eq(u, "signing") || String.eq(u, "authentication")

def Join.cons_if(b: Bool, x: String, xs: List<&2, String>) -> List<&2, String>:
  match b:
    case True{}:
      x <> xs
    case False{}:
      xs

def Join.invalid_usages(us: List<&2, String>) -> List<&2, String>:
  match us:
    case Nil{}:
      Nil{}
    case Con{+u, t}:
      Join.cons_if(Bool.not(Join.known_usage(u)), u, Join.invalid_usages(t))

def Join.usages_err(bad: List<&2, String>) -> String:
  match bad:
    case Nil{}:
      ""
    case Con{h, t}:
      "invalid bootstrap token usage string: " ++ String.join(h <> t, ",")
        ++ ", valid usage options: signing,authentication"

# ValidateUsages: "" when every usage is known, else the error.
def Join.validate_usages(us: List<&2, String>) -> String:
  Join.usages_err(Join.sort_uniq(Join.invalid_usages(us)))

# Time (Go time.Parse(time.RFC3339, s), whole seconds).

def Join.dec.keep(ok: Bool, r: Maybe<&2, U32>) -> Maybe<&2, U32>:
  match ok:
    case True{}:
      r
    case False{}:
      None{}

# The value of decimal digits (Some{acc} for ""), None on another char.
def Join.dec(s: String, +acc: U32) -> Maybe<&2, U32>:
  match s:
    case SNil{}:
      Some{acc}
    case SCon{Chr{+c}, t}:
      Join.dec.keep(U32.is_ge(c, 48) && U32.is_le(c, 57), Join.dec(t, (acc * 10 + c - 48 : U32)))

def Join.in_range(m: Maybe<&2, U32>, +lo: U32, +hi: U32) -> Maybe<&2, U32>:
  match m:
    case None{}:
      None{}
    case Some{+x}:
      Join.dec.keep(U32.is_ge(x, lo) && U32.is_le(x, hi), Some{x})

# parseUint(s[i:i+n], lo, hi).
def Join.field(+s: String, i: Nat, n: Nat, +lo: U32, +hi: U32) -> Maybe<&2, U32>:
  Join.in_range(Join.dec(Join.sub(s, i, n), 0), lo, hi)

def Join.leap(+y: U32) -> Bool:
  (U32.is_eq((y % 4 : U32), 0) && Bool.not(U32.is_eq((y % 100 : U32), 0))) || U32.is_eq((y % 400 : U32), 0)

def Join.days_in.feb(leap: Bool) -> U32:
  match leap:
    case True{}:
      29
    case False{}:
      28

def Join.days_in.go(feb: Bool, short: Bool, +y: U32) -> U32:
  match feb short:
    case True{} _:
      Join.days_in.feb(Join.leap(y))
    case False{} True{}:
      30
    case False{} False{}:
      31

# daysIn(month, year).
def Join.days_in(+m: U32, +y: U32) -> U32:
  Join.days_in.go(U32.is_eq(m, 2), U32.is_eq(m, 4) || U32.is_eq(m, 6) || U32.is_eq(m, 9) || U32.is_eq(m, 11), y)

# Days since -0400-03-01 (Howard Hinnant's days_from_civil, shifted by one
# era so that year 0 stays positive).
def Join.civil_days.go(+y: U32, +mp: U32, +d: U32) -> U32:
  ((y / 400) * 146097 + (y % 400) * 365 + (y % 400) / 4 - (y % 400) / 100 + (153 * mp + 2) / 5 + d - 1 : U32)

def Join.civil_days.early(+y: U32, +m: U32, +d: U32, early: Bool) -> U32:
  match early:
    case True{}:
      Join.civil_days.go((y + 399 : U32), (m + 9 : U32), d)
    case False{}:
      Join.civil_days.go((y + 400 : U32), (m - 3 : U32), d)

def Join.civil_days(+y: U32, +m: U32, +d: U32) -> U32:
  Join.civil_days.early(y, m, d, U32.is_le(m, 2))

# The days of 1970-01-01.
def Join.epoch_days() -> U32:
  865565

def Join.norm(+d: U32, +s: U32) -> Join.Time:
  Time{(d + s / 86400 : U32), (s % 86400 : U32)}

# A Unix time in seconds.
def Join.time_of_unix(+secs: U32) -> Join.Time:
  Time{(secs / 86400 + Join.epoch_days() : U32), (secs % 86400 : U32)}

# A wall-clock reading (bend-kube Sys.wall).
def Join.time_of_wall(w: T.Wall) -> Join.Time:
  match w:
    case T.Wall{d, s, us}:
      Time{(d + Join.epoch_days() : U32), s}

# t plus secs.
def Join.after(t: Join.Time, +secs: U32) -> Join.Time:
  match t:
    case Time{d, s}:
      Join.norm(d, (s + secs : U32))

# A local time at offset off (seconds east when east) in UTC.
def Join.shift(+days: U32, +secs: U32, +off: U32, east: Bool) -> Join.Time:
  match east:
    case True{}:
      Join.norm((days - 1 : U32), (secs + 86400 - off : U32))
    case False{}:
      Join.norm(days, (secs + off : U32))

def Join.zone.off(ok: Bool, east: Bool, hr: Maybe<&2, U32>, mm: Maybe<&2, U32>, +days: U32, +secs: U32) -> Maybe<&2, Join.Time>:
  match ok hr mm:
    case True{} Some{+h} Some{+m}:
      Some{Join.shift(days, secs, ((h * 60 + m) * 60 : U32), east)}
    case _ _ _:
      None{}

def Join.zone.go(utc: Bool, +z: String, +days: U32, +secs: U32) -> Maybe<&2, Join.Time>:
  match utc:
    case True{}:
      Some{Time{days, secs}}
    case False{}:
      Join.zone.off(
        Nat.is_eq(String.length(z), 6n) && Join.char_at(z, 3n, 58) && (Join.char_at(z, 0n, 43) || Join.char_at(z, 0n, 45)),
        Join.char_at(z, 0n, 43), Join.field(z, 1n, 2n, 0, 23), Join.field(z, 4n, 2n, 0, 59), days, secs)

# The time zone: "Z" or [+-]hh:mm.
def Join.zone(+z: String, +days: U32, +secs: U32) -> Maybe<&2, Join.Time>:
  Join.zone.go(String.eq(z, "Z"), z, days, secs)

def Join.starts_digit(s: String) -> Bool:
  match s:
    case SNil{}:
      False{}
    case SCon{c, t}:
      Char.is_digit(c)

def Join.skip_digits(s: String) -> String:
  match s:
    case SNil{}:
      SNil{}
    case SCon{+c, +t}:
      Join.pick_str(Char.is_digit(c), Join.skip_digits(t), SCon{c, t})

# Drops a fraction "." digit+ from the front.
def Join.frac(s: String) -> String:
  match s:
    case SNil{}:
      SNil{}
    case SCon{Chr{+c}, +t}:
      Join.pick_str(U32.is_eq(c, 46) && Join.starts_digit(t), Join.skip_digits(t), SCon{Chr{c}, t})

def Join.seps(+s: String) -> Bool:
  Join.char_at(s, 4n, 45) && Join.char_at(s, 7n, 45) && Join.char_at(s, 10n, 84)
    && Join.char_at(s, 13n, 58) && Join.char_at(s, 16n, 58)

def Join.parse_time.go(ok: Bool, y: Maybe<&2, U32>, mo: Maybe<&2, U32>, d: Maybe<&2, U32>, h: Maybe<&2, U32>,
  mi: Maybe<&2, U32>, se: Maybe<&2, U32>, zone: String) -> Maybe<&2, Join.Time>:
  match ok y mo d h mi se:
    case True{} Some{+y1} Some{+mo1} Some{+d1} Some{+h1} Some{+mi1} Some{+se1}:
      Join.zone(zone, Join.civil_days(y1, mo1, d1), (h1 * 3600 + mi1 * 60 + se1 : U32))
    case _ _ _ _ _ _ _:
      None{}

# time.Parse(time.RFC3339, s) (Go's parseRFC3339), to whole seconds.
def Join.parse_time(+s: String) -> Maybe<&2, Join.Time>:
  +y = Join.field(s, 0n, 4n, 0, 9999)
  +mo = Join.field(s, 5n, 2n, 1, 12)
  Join.parse_time.go(Nat.is_le(19n, String.length(s)) && Join.seps(s), y, mo,
    Join.field(s, 8n, 2n, 1, Join.days_in(Maybe.default(&2, U32, mo, 1), Maybe.default(&2, U32, y, 0))),
    Join.field(s, 11n, 2n, 0, 23), Join.field(s, 14n, 2n, 0, 59), Join.field(s, 17n, 2n, 0, 59),
    Join.frac(String.drop(s, 19n)))

# "YYYY-MM-DDTHH:MM:SSZ" (time.RFC3339 in UTC).
def Join.rfc3339(t: Join.Time) -> String:
  match t:
    case Time{d, s}:
      T.Wall.rfc3339(T.Wall{(d - Join.epoch_days() : U32), s, 0})

# a at or before b.
def Join.time_le(a: Join.Time, b: Join.Time) -> Bool:
  match a b:
    case Time{+d1, s1} Time{+d2, s2}:
      U32.is_lt(d1, d2) || (U32.is_eq(d1, d2) && U32.is_le(s1, s2))

# Secrets.

def Join.str(k: String, v: String) -> J.KV:
  J.KV{k, J.JStr{v}}

# A Secret data value: base64 of the UTF-8 bytes.
def Join.b64(s: String) -> J.Json:
  J.JStr{B.B64.encode(U.Utf8.encode(s))}

def Join.data.dec(m: Maybe<&2, List<&2, U32>>) -> String:
  match m:
    case None{}:
      ""
    case Some{bs}:
      U.Utf8.decode_all(bs)

def Join.data.of(j: J.Json) -> String:
  match j:
    case J.JStr{b}:
      Join.data.dec(B.B64.decode(b))
    case _:
      ""

# secrets.GetData: data[key], "" when absent.
def Join.data(+s: J.Json, +key: String) -> String:
  Join.data.of(J.Json.at(s, ["data", key]))

def Join.name_of(+s: J.Json) -> String:
  J.Json.str_or(J.Json.at(s, ["metadata", "name"]), "")

def Join.expiration_kv(e: Maybe<&2, Join.Time>) -> List<&2, J.KV>:
  match e:
    case None{}:
      Nil{}
    case Some{t}:
      [J.KV{"expiration", Join.b64(Join.rfc3339(t))}]

def Join.token_data(id: String, secret: String, e: Maybe<&2, Join.Time>) -> List<&2, J.KV>:
  a b = Join.b64(id) Join.b64(secret)
  List.append(&2, J.KV,
    [J.KV{"token-id", a}, J.KV{"token-secret", b},
     J.KV{"usage-bootstrap-signing", Join.b64("true")},
     J.KV{"usage-bootstrap-authentication", Join.b64("true")},
     J.KV{"auth-extra-groups", Join.b64("system:bootstrappers:kubeadm:default-node-token")},
     J.KV{"description", Join.b64("token generated by cluster-api-bootstrap-provider-kubeadm")}],
    Join.expiration_kv(e))

# The Secret `vcluster token create` creates (create.go:203-225): token id
# and secret, a control-plane or worker token, and its expiration (None:
# never, as with --expires "").
def Join.token_secret(+id: String, secret: String, cp: Bool, e: Maybe<&2, Join.Time>) -> J.Json:
  J.Json.obj([
    J.KV{"metadata", J.Json.obj([Join.str("name", Join.secret_name(id)), Join.str("namespace", "kube-system"),
      J.KV{"labels", J.Json.obj([Join.str(Join.token_label(), "true"), Join.str(Join.node_type_label(), Join.node_type(cp))])}])},
    Join.str("type", Join.secret_type()),
    J.KV{"data", J.Json.obj(Join.token_data(id, secret, e))}])

# The expiration of a token made at now with a TTL of secs.
def Join.expiry(now: Join.Time, +secs: U32) -> Join.Time:
  Join.after(now, secs)

def Join.expired.go(empty: Bool, t: Maybe<&2, Join.Time>, now: Join.Time) -> Bool:
  match empty t:
    case True{} _:
      False{}
    case False{} None{}:
      True{}
    case False{} Some{x}:
      Join.time_le(x, now)

def Join.expired.at(+e: String, now: Join.Time) -> Bool:
  Join.expired.go(String.is_empty(e), Join.parse_time(e), now)

# secrets.HasExpired: the expiration is at or before now. No expiration
# never expires; an unparseable one counts as expired.
def Join.expired(+s: J.Json, now: Join.Time) -> Bool:
  Join.expired.at(Join.data(s, "expiration"), now)

def Join.groups.check(ok: Bool, gs: List<&2, String>) -> Maybe<&2, List<&2, String>>:
  match ok:
    case True{}:
      Some{Join.insert(Join.default_group(), Join.sort_uniq(gs))}
    case False{}:
      None{}

def Join.groups.go(empty: Bool, +gs: List<&2, String>) -> Maybe<&2, List<&2, String>>:
  match empty:
    case True{}:
      Some{[Join.default_group()]}
    case False{}:
      Join.groups.check(Join.all_valid_groups(gs), gs)

def Join.groups.of(+e: String) -> Maybe<&2, List<&2, String>>:
  Join.groups.go(String.is_empty(e), String.split(e, ','))

# secrets.GetGroups: system:bootstrappers and the auth-extra-groups, sorted
# and unique; None if an extra group is invalid.
def Join.groups(+s: J.Json) -> Maybe<&2, List<&2, String>>:
  Join.groups.of(Join.data(s, "auth-extra-groups"))

def Join.secret_node_type.or(+t: String) -> String:
  Join.pick_str(String.is_empty(t), "worker", t)

# The node type of a token's Secret; worker when it has no label.
def Join.secret_node_type(+s: J.Json) -> String:
  Join.secret_node_type.or(J.Json.str_or(J.Json.at(s, ["metadata", "labels", Join.node_type_label()]), ""))

# Authentication (plugin/pkg/auth/authenticator/token/bootstrap).

# The secret named name among secrets (the test's lister).
def Join.find.pick(hit: Bool, s: J.Json, rest: Maybe<&2, J.Json>) -> Maybe<&2, J.Json>:
  match hit:
    case True{}:
      Some{s}
    case False{}:
      rest

def Join.find(secrets: List<&2, J.Json>, +name: String) -> Maybe<&2, J.Json>:
  match secrets:
    case Nil{}:
      None{}
    case Con{+s, t}:
      Join.find.pick(String.eq(Join.name_of(s), name), s, Join.find(t, name))

# Every check of AuthenticateToken but the expiration: not being deleted,
# the type, data present, the secret and the id, usage-bootstrap-
# authentication=true. The two data reads run as a parallel let.
def Join.verify.checks(tok: Join.Token, +s: J.Json) -> Bool:
  match tok:
    case Token{id, secret}:
      ts tid = Join.data(s, "token-secret") Join.data(s, "token-id")
      J.Json.is_null(J.Json.at(s, ["metadata", "deletionTimestamp"]))
        && String.eq(J.Json.str_or(J.Json.get(s, "type"), ""), Join.secret_type())
        && Bool.not(J.Json.is_null(J.Json.get(s, "data")))
        && String.eq(ts, secret) && String.eq(tid, id)
        && String.eq(Join.data(s, "usage-bootstrap-authentication"), "true")

def Join.verify.user(id: String, gs: Maybe<&2, List<&2, String>>) -> Maybe<&2, Join.User>:
  match gs:
    case None{}:
      None{}
    case Some{g}:
      Some{User{"system:bootstrap:" ++ id, g}}

def Join.verify.ok(ok: Bool, tok: Join.Token, +s: J.Json) -> Maybe<&2, Join.User>:
  match ok:
    case False{}:
      None{}
    case True{}:
      Join.verify.user(Join.token_id(tok), Join.groups(s))

def Join.verify.exp(exp: Bool, +tok: Join.Token, +s: J.Json) -> Maybe<&2, Join.User>:
  match exp:
    case True{}:
      None{}
    case False{}:
      Join.verify.ok(Join.verify.checks(tok, s), tok, s)

# AuthenticateToken once the lister found the token's Secret. Every check
# only refuses, so their order does not change the answer; the expiration
# goes first.
def Join.verify(+tok: Join.Token, +s: J.Json, now: Join.Time) -> Maybe<&2, Join.User>:
  Join.verify.exp(Join.expired(s, now), tok, s)

def Join.authenticate.found(f: Maybe<&2, J.Json>, +tok: Join.Token, now: Join.Time) -> Maybe<&2, Join.User>:
  match f:
    case None{}:
      None{}
    case Some{s}:
      Join.verify(tok, s, now)

def Join.authenticate.go(m: Maybe<&2, Join.Token>, secrets: List<&2, J.Json>, now: Join.Time) -> Maybe<&2, Join.User>:
  match m:
    case None{}:
      None{}
    case Some{+tok}:
      Join.authenticate.found(Join.find(secrets, Join.secret_name(Join.token_id(tok))), tok, now)

# TokenAuthenticator.AuthenticateToken over the Secrets of kube-system:
# the user, or None (not found).
def Join.authenticate(+token: String, secrets: List<&2, J.Json>, now: Join.Time) -> Maybe<&2, Join.User>:
  Join.authenticate.go(Join.parse_token(token), secrets, now)

# Authorizing /node/join (vk8s design; the vcluster handler is closed source).

def Join.q_token(q: Join.Query) -> String:
  match q:
    case Query{t, n}:
      t

def Join.q_type(q: Join.Query) -> String:
  match q:
    case Query{t, n}:
      n

def Join.lookup.go(m: Maybe<&2, Join.Token>) -> Maybe<&2, String>:
  match m:
    case None{}:
      None{}
    case Some{tok}:
      Some{Join.secret_name(Join.token_id(tok))}

# The kube-system Secret a request's token names; None for a malformed token
# (refused without a lookup).
def Join.lookup(q: Join.Query) -> Maybe<&2, String>:
  Join.lookup.go(Join.parse_token(Join.q_token(q)))

def Join.authorize.type(ok: Bool, user: Join.User, +has: String) -> Join.Auth:
  match ok:
    case True{}:
      Allowed{user, has}
    case False{}:
      Denied{403, "the token is for " ++ has ++ " nodes"}

def Join.authorize.user(u: Maybe<&2, Join.User>, +asked: String, +has: String) -> Join.Auth:
  match u:
    case None{}:
      Denied{401, "invalid token"}
    case Some{user}:
      Join.authorize.type(String.is_empty(asked) || String.eq(asked, has), user, has)

def Join.authorize.tok(m: Maybe<&2, Join.Token>, +q: Join.Query, +s: J.Json, now: Join.Time) -> Join.Auth:
  match m:
    case None{}:
      Denied{401, "malformed token"}
    case Some{tok}:
      Join.authorize.user(Join.verify(tok, s, now), Join.q_type(q), Join.secret_node_type(s))

def Join.authorize.exp(exp: Bool, +q: Join.Query, +s: J.Json, now: Join.Time) -> Join.Auth:
  match exp:
    case True{}:
      Denied{401, "token expired"}
    case False{}:
      Join.authorize.tok(Join.parse_token(Join.q_token(q)), q, s, now)

# The decision on a /node/join request, given the Secret Join.lookup named
# (None: not found) and the time: the token must authenticate as kube-
# apiserver would, and a node type asked for must be the token's own.
def Join.authorize(+q: Join.Query, found: Maybe<&2, J.Json>, +now: Join.Time) -> Join.Auth:
  match found:
    case None{}:
      Denied{401, "unknown token"}
    case Some{+s}:
      Join.authorize.exp(Join.expired(s, now), q, s, now)

def Join.allowed(a: Join.Auth) -> Bool:
  match a:
    case Allowed{u, n}:
      True{}
    case Denied{c, r}:
      False{}

# URLs (Go net/url).

def Join.hex_up(+d: U32) -> Char:
  Chr{(48 + d + 7 * Bool.to_u32(U32.is_gt(d, 9)) : U32)}

def Join.unreserved(+b: U32) -> Bool:
  (U32.is_ge(b, 97) && U32.is_le(b, 122)) || (U32.is_ge(b, 65) && U32.is_le(b, 90))
    || (U32.is_ge(b, 48) && U32.is_le(b, 57)) || U32.is_eq(b, 45) || U32.is_eq(b, 95)
    || U32.is_eq(b, 46) || U32.is_eq(b, 126)

def Join.esc_byte(keep: Bool, space: Bool, +b: U32, rest: String) -> String:
  match keep space:
    case True{} _:
      SCon{Chr{b}, rest}
    case False{} True{}:
      SCon{'+', rest}
    case False{} False{}:
      SCon{'%', SCon{Join.hex_up(U32.shrn(b, 4n)), SCon{Join.hex_up(U32.and(b, 15)), rest}}}

def Join.esc_bytes(bs: List<&2, U32>) -> String:
  match bs:
    case Nil{}:
      SNil{}
    case Con{+b, t}:
      Join.esc_byte(Join.unreserved(b), U32.is_eq(b, 32), b, Join.esc_bytes(t))

# url.QueryEscape.
def Join.query_escape(s: String) -> String:
  Join.esc_bytes(U.Utf8.encode(s))

def Join.is_hex(+x: U32) -> Bool:
  (U32.is_ge(x, 48) && U32.is_le(x, 57)) || (U32.is_ge(x, 97) && U32.is_le(x, 102))
    || (U32.is_ge(x, 65) && U32.is_le(x, 70))

def Join.hex_val.go(digit: Bool, lower: Bool, +x: U32) -> U32:
  match digit lower:
    case True{} _:
      (x - 48 : U32)
    case False{} True{}:
      (x - 87 : U32)
    case False{} False{}:
      (x - 55 : U32)

def Join.hex_val(+x: U32) -> U32:
  Join.hex_val.go(U32.is_le(x, 57), U32.is_ge(x, 97), x)

def Join.esc.plain(pct: Bool) -> Join.Esc:
  match pct:
    case True{}:
      EscHi{}
    case False{}:
      EscPlain{}

def Join.esc.hi(hex: Bool, +x: U32) -> Join.Esc:
  match hex:
    case True{}:
      EscLo{Join.hex_val(x)}
    case False{}:
      EscBad{}

def Join.esc.lo(hex: Bool) -> Join.Esc:
  match hex:
    case True{}:
      EscPlain{}
    case False{}:
      EscBad{}

def Join.esc.next(st: Join.Esc, +x: U32) -> Join.Esc:
  match st:
    case EscPlain{}:
      Join.esc.plain(U32.is_eq(x, 37))
    case EscHi{}:
      Join.esc.hi(Join.is_hex(x), x)
    case EscLo{h}:
      Join.esc.lo(Join.is_hex(x))
    case EscBad{}:
      EscBad{}

def Join.esc.plain_out(pct: Bool, plus: Bool, +x: U32, acc: List<&2, U32>) -> List<&2, U32>:
  match pct plus:
    case True{} _:
      acc
    case False{} True{}:
      32 <> acc
    case False{} False{}:
      List.append(&2, U32, List.reverse(&2, U32, U.Utf8.put(x, Nil{})), acc)

# The bytes a char adds (reversed onto acc).
def Join.esc.out(st: Join.Esc, +x: U32, acc: List<&2, U32>) -> List<&2, U32>:
  match st:
    case EscPlain{}:
      Join.esc.plain_out(U32.is_eq(x, 37), U32.is_eq(x, 43), x, acc)
    case EscHi{}:
      acc
    case EscLo{h}:
      (h * 16 + Join.hex_val(x) : U32) <> acc
    case EscBad{}:
      acc

def Join.unesc.fin(st: Join.Esc, acc: List<&2, U32>) -> Maybe<&2, String>:
  match st:
    case EscPlain{}:
      Some{U.Utf8.decode_all(List.reverse(&2, U32, acc))}
    case _:
      None{}

def Join.unesc(s: String, +st: Join.Esc, acc: List<&2, U32>) -> Maybe<&2, String>:
  match s:
    case SNil{}:
      Join.unesc.fin(st, acc)
    case SCon{Chr{+x}, t}:
      Join.unesc(t, Join.esc.next(st, x), Join.esc.out(st, x, acc))

# url.QueryUnescape: None for a "%" without two hex digits.
def Join.query_unescape(s: String) -> Maybe<&2, String>:
  Join.unesc(s, EscPlain{}, Nil{})

def Join.cut.push(c: Char, r: Join.Cut) -> Join.Cut:
  match r:
    case Cut{b, a, f}:
      Cut{SCon{c, b}, a, f}

def Join.cut.at(hit: Bool, +c: Char, +t: String, rec: Join.Cut) -> Join.Cut:
  match hit:
    case True{}:
      Cut{"", t, True{}}
    case False{}:
      Join.cut.push(c, rec)

# strings.Cut(s, sep) for a one-char sep.
def Join.cut(s: String, +sep: U32) -> Join.Cut:
  match s:
    case SNil{}:
      Cut{"", "", False{}}
    case SCon{Chr{+c}, +t}:
      Join.cut.at(U32.is_eq(c, sep), Chr{c}, t, Join.cut(t, sep))

def Join.param.mk(k: Maybe<&2, String>, v: Maybe<&2, String>) -> Join.Seg:
  match k v:
    case Some{a} Some{b}:
      SegOk{Param{a, b}}
    case _ _:
      SegErr{}

def Join.param.kv(c: Join.Cut) -> Join.Seg:
  match c:
    case Cut{k, v, f}:
      Join.param.mk(Join.query_unescape(k), Join.query_unescape(v))

def Join.param.go(semi: Bool, empty: Bool, seg: String) -> Join.Seg:
  match semi empty:
    case True{} _:
      SegErr{}
    case False{} True{}:
      SegSkip{}
    case False{} False{}:
      Join.param.kv(Join.cut(seg, 61))

def Join.param(+seg: String) -> Join.Seg:
  Join.param.go(String.contains(seg, ";"), String.is_empty(seg), seg)

def Join.values.add(r: Join.Seg, rest: Join.Values) -> Join.Values:
  match r rest:
    case SegSkip{} Values{ps, ok}:
      Values{ps, ok}
    case SegErr{} Values{ps, ok}:
      Values{ps, False{}}
    case SegOk{p} Values{ps, ok}:
      Values{p <> ps, ok}

def Join.values.of(segs: List<&2, String>) -> Join.Values:
  match segs:
    case Nil{}:
      Values{Nil{}, True{}}
    case Con{seg, t}:
      Join.values.add(Join.param(seg), Join.values.of(t))

# url.ParseQuery: segments split at "&"; a segment with ";" is an error, an
# empty one is skipped, and key and value are unescaped.
def Join.parse_query(q: String) -> Join.Values:
  Join.values.of(String.split(q, '&'))

def Join.params(v: Join.Values) -> List<&2, Join.Param>:
  match v:
    case Values{ps, ok}:
      ps

# Values.Get: the first value of key, "" when absent.
def Join.get(ps: List<&2, Join.Param>, +k: String) -> String:
  match ps:
    case Nil{}:
      ""
    case Con{Param{a, b}, t}:
      Join.pick_str(String.eq(a, k), b, Join.get(t, k))

def Join.request.fin(missing: Bool, ok: Bool, token: String, ty: String) -> Join.Req:
  match missing ok:
    case True{} _:
      ReqErr{401, "missing token"}
    case False{} False{}:
      ReqErr{400, "invalid node type " ++ String.quote(ty)}
    case False{} True{}:
      ReqOk{Query{token, ty}}

def Join.request.check(+token: String, +ty: String) -> Join.Req:
  Join.request.fin(String.is_empty(token),
    String.is_empty(ty) || String.eq(ty, "worker") || String.eq(ty, "control-plane"), token, ty)

def Join.request.query(+ps: List<&2, Join.Param>) -> Join.Req:
  Join.request.check(Join.get(ps, "token"), Join.get(ps, "type"))

def Join.request.path(ok: Bool, query: String) -> Join.Req:
  match ok:
    case False{}:
      ReqErr{404, "404 page not found"}
    case True{}:
      Join.request.query(Join.params(Join.parse_query(query)))

def Join.request.go(c: Join.Cut) -> Join.Req:
  match c:
    case Cut{path, query, f}:
      Join.request.path(String.eq(path, "/node/join"), query)

# A /node/join request target "<path>?<query>": the token, and a type of
# worker or control-plane when given (the docker driver sends
# type=worker; `vcluster token create` prints none).
def Join.parse_request(target: String) -> Join.Req:
  Join.request.go(Join.cut(target, 63))

# Command lines.

def Join.join_command.go(direct: Bool, platform: String, api: String, t: String) -> String:
  match direct:
    case True{}:
      "curl -fsSLk \"https://" ++ api ++ "/node/join?token=" ++ t ++ "\" | sh -\n"
    case False{}:
      "curl -fsSLk \"" ++ platform ++ "/node/join?token=" ++ t ++ "\" | sh -\n"

# What `vcluster token create` prints (create.go:120-128): the platform's
# join-script endpoint when the kubeadm-config ConfigMap names one, else the
# API endpoint (ClusterConfiguration.controlPlaneEndpoint).
def Join.join_command(+platform: String, api: String, token: String) -> String:
  Join.join_command.go(String.is_empty(platform), platform, api, Join.query_escape(token))

# What `vcluster token create --kubeadm` prints.
def Join.kubeadm_command(api: String, token: String, ca_hash: String) -> String:
  "kubeadm join " ++ api ++ " --token " ++ token ++ " --discovery-token-ca-cert-hash " ++ ca_hash ++ "\n"

# The script the docker driver runs in a worker container
# (create_docker.go:741-748), with the control plane's host name.
def Join.docker_join(host: String, token: String, k8s_version: String, arch: String) -> String:
  "\nsleep 2\nuntil curl -fsSLk -o /tmp/join.sh \"https://" ++ host ++ ":8443/node/join?token="
    ++ Join.query_escape(token) ++ "&type=worker\"; do\n  echo \"Waiting for vCluster API to be ready...\"\n"
    ++ "  sleep 2\ndone\nsh /tmp/join.sh --bundle-path /var/lib/vcluster/bin/kubernetes-" ++ k8s_version
    ++ "-" ++ arch ++ ".tar.gz --force-join\n"

# The CA cert hash (pubkeypin.Hash): sha256 of the certificate's DER
# SubjectPublicKeyInfo.

def Join.der.len(short: Bool, one: Bool, two: Bool, +tag: U32, +l0: U32, rest: List<&2, U32>) -> Maybe<&2, Join.Tlv>:
  match short one two rest:
    case True{} _ _ _:
      Some{Tlv{tag, 2n, U32.to_nat(l0)}}
    case False{} True{} _ Con{a, r}:
      Some{Tlv{tag, 3n, U32.to_nat(a)}}
    case False{} False{} True{} Con{+a, Con{+b, r}}:
      Some{Tlv{tag, 4n, U32.to_nat((a * 256 + b : U32))}}
    case _ _ _ _:
      None{}

# The header of the first DER element (lengths up to two bytes).
def Join.der.hdr(bs: List<&2, U32>) -> Maybe<&2, Join.Tlv>:
  match bs:
    case Con{+tag, Con{+l0, rest}}:
      Join.der.len(U32.is_lt(l0, 128), U32.is_eq(l0, 129), U32.is_eq(l0, 130), tag, l0, rest)
    case _:
      None{}

def Join.der.content(m: Maybe<&2, Join.Tlv>, bs: List<&2, U32>) -> Maybe<&2, List<&2, U32>>:
  match m:
    case None{}:
      None{}
    case Some{Tlv{t, h, l}}:
      Some{List.take(&2, U32, List.drop(&2, U32, bs, h), l)}

def Join.der.skip(m: Maybe<&2, Join.Tlv>, bs: List<&2, U32>) -> Maybe<&2, List<&2, U32>>:
  match m:
    case None{}:
      None{}
    case Some{Tlv{t, h, l}}:
      Some{List.drop(&2, U32, bs, Nat.add(h, l))}

def Join.der.whole(m: Maybe<&2, Join.Tlv>, bs: List<&2, U32>) -> Maybe<&2, List<&2, U32>>:
  match m:
    case None{}:
      None{}
    case Some{Tlv{t, h, l}}:
      Some{List.take(&2, U32, bs, Nat.add(h, l))}

# The contents of the first element.
def Join.der.enter(m: Maybe<&2, List<&2, U32>>) -> Maybe<&2, List<&2, U32>>:
  match m:
    case None{}:
      None{}
    case Some{+bs}:
      Join.der.content(Join.der.hdr(bs), bs)

# What follows the first element.
def Join.der.next(m: Maybe<&2, List<&2, U32>>) -> Maybe<&2, List<&2, U32>>:
  match m:
    case None{}:
      None{}
    case Some{+bs}:
      Join.der.skip(Join.der.hdr(bs), bs)

# The first element, header included.
def Join.der.first(m: Maybe<&2, List<&2, U32>>) -> Maybe<&2, List<&2, U32>>:
  match m:
    case None{}:
      None{}
    case Some{+bs}:
      Join.der.whole(Join.der.hdr(bs), bs)

def Join.der.is_tag(bs: List<&2, U32>, +t: U32) -> Bool:
  match bs:
    case Nil{}:
      False{}
    case Con{x, r}:
      U32.is_eq(x, t)

def Join.der.version.go(v: Bool, +bs: List<&2, U32>) -> Maybe<&2, List<&2, U32>>:
  match v:
    case True{}:
      Join.der.skip(Join.der.hdr(bs), bs)
    case False{}:
      Some{bs}

# Skips tbsCertificate's [0] EXPLICIT version when present.
def Join.der.version(m: Maybe<&2, List<&2, U32>>) -> Maybe<&2, List<&2, U32>>:
  match m:
    case None{}:
      None{}
    case Some{+bs}:
      Join.der.version.go(Join.der.is_tag(bs, 160), bs)

# x509.Certificate.RawSubjectPublicKeyInfo: Certificate → tbsCertificate →
# past version, serialNumber, signature, issuer, validity and subject.
def Join.spki(der: Maybe<&2, List<&2, U32>>) -> Maybe<&2, List<&2, U32>>:
  Join.der.first(Join.der.next(Join.der.next(Join.der.next(Join.der.next(Join.der.next(
    Join.der.version(Join.der.enter(Join.der.enter(der)))))))))

def Join.pem.cls.go(begin: Bool, end: Bool) -> Join.PemLine:
  match begin end:
    case True{} _:
      PemBegin{}
    case False{} True{}:
      PemEnd{}
    case False{} False{}:
      PemOther{}

def Join.pem.cls(l: String) -> Join.PemLine:
  +t = String.trim(l)
  Join.pem.cls.go(String.eq(t, "-----BEGIN CERTIFICATE-----"), String.eq(t, "-----END CERTIFICATE-----"))

def Join.pem.next(st: Join.PemSt, k: Join.PemLine, l: String) -> Join.PemSt:
  match st k:
    case PemOut{} PemBegin{}:
      PemIn{""}
    case PemOut{} _:
      PemOut{}
    case PemIn{b} PemEnd{}:
      PemOut{}
    case PemIn{b} _:
      PemIn{b ++ l}

def Join.pem.out(st: Join.PemSt, k: Join.PemLine) -> Maybe<&2, String>:
  match st k:
    case PemIn{b} PemEnd{}:
      Some{b}
    case _ _:
      None{}

def Join.pem.emit(m: Maybe<&2, String>, rest: List<&2, String>) -> List<&2, String>:
  match m:
    case None{}:
      rest
    case Some{b}:
      b <> rest

def Join.pem.go(ls: List<&2, String>, +st: Join.PemSt) -> List<&2, String>:
  match ls:
    case Nil{}:
      Nil{}
    case Con{+l, t}:
      +k = Join.pem.cls(l)
      Join.pem.emit(Join.pem.out(st, k), Join.pem.go(t, Join.pem.next(st, k, l)))

# The base64 bodies of the PEM CERTIFICATE blocks, in order.
def Join.pem_certs(pem: String) -> List<&2, String>:
  Join.pem.go(String.lines(pem), PemOut{})

def Join.ca_hash.one(m: Maybe<&2, List<&2, U32>>) -> Join.Hash:
  match m:
    case None{}:
      HashErr{"failed to load CA certificate referenced by kubeconfig: x509: malformed certificate"}
    case Some{spki}:
      HashOk{"sha256:" ++ H.Sha256.hex(H.Sha256.digest(spki))}

def Join.ca_hash.go(bodies: List<&2, String>) -> Join.Hash:
  match bodies:
    case Nil{}:
      HashErr{"failed to load CA certificate referenced by kubeconfig: data does not contain any valid RSA or ECDSA certificates"}
    case Con{b, Nil{}}:
      Join.ca_hash.one(Join.spki(B.B64.decode(b)))
    case Con{b, Con{c, r}}:
      HashErr{"multiple CA certificates found in configmap kube-root-ca.crt"}

# The --discovery-token-ca-cert-hash of the kube-root-ca.crt ConfigMap's
# ca.crt (create.go:228-247): "sha256:" and the lowercase hex.
def Join.ca_hash(pem: String) -> Join.Hash:
  Join.ca_hash.go(Join.pem_certs(pem))

# The join script vk8s serves at /node/join (vk8s design: vcluster's is
# closed source). It takes the flags vcluster documents for its script,
# acts on --force-join, --skip-join, --reset-only and --node-name, accepts
# and ignores the download flags (vk8s guests carry their binaries), and
# runs kubeadm join with the discovery hash. Control-plane joins are
# refused: vk8s does not add control-plane nodes yet.

# A POSIX shell single-quoted word.
def Join.sq.char(q: Bool, c: Char, rest: String) -> String:
  match q:
    case True{}:
      "'\\''" ++ rest
    case False{}:
      SCon{c, rest}

def Join.sq.go(s: String) -> String:
  match s:
    case SNil{}:
      ""
    case SCon{Chr{+c}, t}:
      Join.sq.char(U32.is_eq(c, 39), Chr{c}, Join.sq.go(t))

def Join.sq(s: String) -> String:
  "'" ++ Join.sq.go(s) ++ "'"

def Join.script.head(node_type: String) -> String:
  "#!/bin/sh\n"
    ++ "# vk8s join script: joins this machine to the virtual cluster as a\n"
    ++ "# " ++ node_type ++ " node.\n"
    ++ "set -eu\n"
    ++ "force_join=false\n"
    ++ "skip_join=false\n"
    ++ "reset_only=false\n"
    ++ "node_name=\"\"\n"
    ++ "while [ \"$#\" -gt 0 ]; do\n"
    ++ "  case \"$1\" in\n"
    ++ "    --force-join) force_join=true ;;\n"
    ++ "    --skip-join) skip_join=true ;;\n"
    ++ "    --reset-only) reset_only=true ;;\n"
    ++ "    --node-name) node_name=\"$2\"; shift ;;\n"
    ++ "    --node-name=*) node_name=\"${1#--node-name=}\" ;;\n"
    ++ "    --kubernetes-version|--repository-url|--binaries-dir|--cni-binaries-dir|--bundle-path|--selinux-rpm-url) shift ;;\n"
    ++ "    --kubernetes-version=*|--repository-url=*|--binaries-dir=*|--cni-binaries-dir=*|--bundle-path=*|--selinux-rpm-url=*) ;;\n"
    ++ "    --skip-reset|--skip-selinux-rpm|--containerd-selinux) ;;\n"
    ++ "    *) echo \"join: unknown flag $1\" >&2; exit 1 ;;\n"
    ++ "  esac\n"
    ++ "  shift\n"
    ++ "done\n"
    ++ "if [ \"$reset_only\" = true ]; then\n"
    ++ "  kubeadm reset --force\n"
    ++ "  exit 0\n"
    ++ "fi\n"

def Join.script.worker(endpoint: String, token: String, ca_hash: String) -> String:
  "if [ -f /etc/kubernetes/kubelet.conf ]; then\n"
    ++ "  if [ \"$force_join\" != true ]; then\n"
    ++ "    echo \"join: this node has joined already; run again with --force-join to join anew\"\n"
    ++ "    exit 0\n"
    ++ "  fi\n"
    ++ "  kubeadm reset --force\n"
    ++ "fi\n"
    ++ "if [ \"$skip_join\" = true ]; then\n"
    ++ "  exit 0\n"
    ++ "fi\n"
    ++ "set -- join " ++ Join.sq(endpoint) ++ " --token " ++ Join.sq(token)
    ++ " --discovery-token-ca-cert-hash " ++ Join.sq(ca_hash) ++ "\n"
    ++ "if [ -n \"$node_name\" ]; then\n"
    ++ "  set -- \"$@\" --node-name \"$node_name\"\n"
    ++ "fi\n"
    ++ "exec kubeadm \"$@\"\n"

def Join.script.body(cp: Bool, endpoint: String, token: String, ca_hash: String) -> String:
  match cp:
    case True{}:
      "echo \"join: vk8s does not join control-plane nodes yet\" >&2\nexit 1\n"
    case False{}:
      Join.script.worker(endpoint, token, ca_hash)

def Join.script(s: Join.Script) -> String:
  match s:
    case Script{endpoint, token, ca_hash, +node_type}:
      Join.script.head(node_type) ++ Join.script.body(String.eq(node_type, "control-plane"), endpoint, token, ca_hash)

# The HTTP answer of /node/join (vk8s design, docs/ref/standalone-decisions.md
# J1; vcluster's handler is closed source). A guest join server reads the
# request line, finds the token Secret Join.lookup names, and writes
# Join.render(Join.respond(...)).
#
# - The path is checked first, as Go's ServeMux does: any path but
#   /node/join is 404 "404 page not found" (http.NotFound), whatever the
#   method.
# - Only GET is served. Any other method on /node/join is 405 "Method Not
#   Allowed" with "Allow: GET" (ServeMux's answer, without HEAD).
# - An error is plain text, as http.Error writes it: the message of
#   Join.parse_request or the reason of Join.authorize, and a newline.
#   vcluster-docs (troubleshooting.mdx) tell users to read this body.
# - The CA hash is computed only for an allowed token; a CA that does not
#   give one is 500 with Join.ca_hash's message.
# - Success is 200 text/x-shellscript with Join.script's text.

# Go's http.StatusText for the statuses /node/join answers.
def Join.reason(+code: U32) -> String:
  Join.pick_str(U32.is_eq(code, 200), "OK",
  Join.pick_str(U32.is_eq(code, 400), "Bad Request",
  Join.pick_str(U32.is_eq(code, 401), "Unauthorized",
  Join.pick_str(U32.is_eq(code, 403), "Forbidden",
  Join.pick_str(U32.is_eq(code, 404), "Not Found",
  Join.pick_str(U32.is_eq(code, 405), "Method Not Allowed",
  Join.pick_str(U32.is_eq(code, 500), "Internal Server Error", "Error")))))))

# The content type of an error (http.Error's).
def Join.text_type() -> String:
  "text/plain; charset=utf-8"

# The content type of the join script.
def Join.script_type() -> String:
  "text/x-shellscript"

# http.Error: the message and a newline, as plain text.
def Join.fail(code: U32, msg: String) -> Join.Reply:
  Reply{code, Join.text_type(), msg ++ "\n"}

# Whether a reply carries a join script.
def Join.served(r: Join.Reply) -> Bool:
  match r:
    case Reply{c, t, b}:
      String.eq(t, Join.script_type())

def Join.cut_before(c: Join.Cut) -> String:
  match c:
    case Cut{b, a, f}:
      b

# Whether a request target's path is /node/join.
def Join.join_path(target: String) -> Bool:
  String.eq(Join.cut_before(Join.cut(target, 63)), "/node/join")

def Join.respond.hash(h: Join.Hash, endpoint: String, token: String, node_type: String) -> Join.Reply:
  match h:
    case HashErr{msg}:
      Join.fail(500, msg)
    case HashOk{hash}:
      Reply{200, Join.script_type(), Join.script(Script{endpoint, token, hash, node_type})}

def Join.respond.auth(a: Join.Auth, token: String, ca: String, endpoint: String) -> Join.Reply:
  match a:
    case Denied{code, reason}:
      Join.fail(code, reason)
    case Allowed{user, node_type}:
      Join.respond.hash(Join.ca_hash(ca), endpoint, token, node_type)

def Join.respond.lookup(m: Maybe<&2, String>, +q: Join.Query, found: Maybe<&2, J.Json>, ca: String, endpoint: String, now: Join.Time) -> Join.Reply:
  match m:
    case None{}:
      Join.fail(401, "malformed token")
    case Some{name}:
      Join.respond.auth(Join.authorize(q, found, now), Join.q_token(q), ca, endpoint)

def Join.respond.req(r: Join.Req, found: Maybe<&2, J.Json>, ca: String, endpoint: String, now: Join.Time) -> Join.Reply:
  match r:
    case ReqErr{code, msg}:
      Join.fail(code, msg)
    case ReqOk{+q}:
      Join.respond.lookup(Join.lookup(q), q, found, ca, endpoint, now)

def Join.respond.route(path: Bool, get: Bool, target: String, found: Maybe<&2, J.Json>, ca: String, endpoint: String, now: Join.Time) -> Join.Reply:
  match path get:
    case False{} _:
      Join.fail(404, "404 page not found")
    case True{} False{}:
      Join.fail(405, "Method Not Allowed")
    case True{} True{}:
      Join.respond.req(Join.parse_request(target), found, ca, endpoint, now)

# The answer to a request: its method, its target ("<path>?<query>"), the
# Secret Join.lookup named as the server found it (None: not found), the
# CA PEM (kube-root-ca.crt), the kubeadm endpoint the script joins
# (host:port) and the time.
def Join.respond(method: String, +target: String, found: Maybe<&2, J.Json>, ca: String, endpoint: String, now: Join.Time) -> Join.Reply:
  Join.respond.route(Join.join_path(target), String.eq(method, "GET"), target, found, ca, endpoint, now)

def Join.allow(+code: U32) -> String:
  Join.pick_str(U32.is_eq(code, 405), "\r\nAllow: GET", "")

# The whole HTTP/1.1 response: the status line, Content-Type,
# Content-Length (UTF-8 bytes), Allow for a 405, Connection: close, and the
# body. The server closes the connection after it.
def Join.render(r: Join.Reply) -> String:
  match r:
    case Reply{+code, ctype, +body}:
      "HTTP/1.1 " ++ U32.show(code) ++ " " ++ Join.reason(code) ++ "\r\nContent-Type: " ++ ctype
        ++ "\r\nContent-Length: " ++ Nat.show(List.length(&2, U32, U.Utf8.encode(body)))
        ++ Join.allow(code) ++ "\r\nConnection: close\r\n\r\n" ++ body
